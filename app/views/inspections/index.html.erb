<%= content_for :title, "Inspections - Kadibs" %>

<div class="page-wrapper">
  <div class="page-header">
    <div class="page-header-content">
      <h1>Inspections</h1>
      <p class="page-subtitle">Manage safety checks and quality audits</p>
    </div>
    <div class="page-actions">
      <%= link_to new_inspection_path, class: "btn btn-primary" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New Inspection
      <% end %>
    </div>
  </div>

  <div class="filters-bar">
    <div class="filter-group" style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: nowrap; max-width: none; min-width: auto;">
      <span class="filter-label">Status:</span>
      <%= link_to "All", inspections_path, class: "filter-chip #{params[:status].blank? ? 'active' : ''}" %>
      <%= link_to "Pending", inspections_path(status: "pending"), class: "filter-chip #{params[:status] == 'pending' ? 'active' : ''}" %>
      <%= link_to "In Progress", inspections_path(status: "in_progress"), class: "filter-chip #{params[:status] == 'in_progress' ? 'active' : ''}" %>
      <%= link_to "Completed", inspections_path(status: "completed"), class: "filter-chip #{params[:status] == 'completed' ? 'active' : ''}" %>
    </div>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Asset</th>
          <th>Status</th>
          <th>Inspector</th>
          <th>Date</th>
          <th>Completion</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @inspections.any? %>
          <% @inspections.each do |inspection| %>
            <tr>
              <td><%= link_to inspection.title, inspection, class: "table-link font-medium" %></td>
              <td><%= inspection.asset&.name || "—" %></td>
              <td><span class="status-badge status-<%= inspection.status.gsub('_', '-') %>"><%= inspection.status.titleize %></span></td>
              <td><%= inspection.inspector&.full_name || "Unassigned" %></td>
              <td><%= inspection.scheduled_date&.strftime("%b %d, %Y") %></td>
              <td>
                <div class="progress-bar-container" style="width: 100px; height: 6px; background: #e2e8f0; border-radius: 3px;">
                  <% 
                    total = inspection.inspection_items.count
                    completed = inspection.inspection_items.where(checked: true).count
                    pct = total > 0 ? (completed.to_f / total * 100).to_i : 0
                  %>
                  <div class="progress-bar-fill" style="width: <%= pct %>%; background: #10b981; height: 100%; border-radius: 3px;"></div>
                </div>
              </td>
              <td>
                <div class="table-actions">
                  <%= link_to inspection, class: "action-btn", title: "View" do %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <% end %>
                  <%= link_to edit_inspection_path(inspection), class: "action-btn", title: "Edit" do %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  <% end %>
                  <%= button_to inspection_path(inspection), method: :delete, class: "action-btn", title: "Delete", data: { turbo_confirm: "Are you sure you want to delete this inspection?" } do %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="empty-table">
              <div class="empty-state">
                <p>No inspections found matching your criteria</p>
                <%= link_to "Create Inspection", new_inspection_path, class: "btn btn-primary btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <% if @pagy.pages > 1 %>
    <div class="pagination-container">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>

<%= render "shared/table_styles" %>
