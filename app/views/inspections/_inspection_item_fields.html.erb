<div class="nested-form-wrapper form-card" style="background: #f8fafc; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #e2e8f0;" data-new-record="<%= f.object.new_record? %>">
  <div class="form-row">
    <div class="form-group" style="flex: 3;">
      <%= f.label :description, "Check Item", class: "form-label" %>
      <%= f.text_field :description, class: "form-input", placeholder: "Check for wear/damage" %>
    </div>
    <div class="form-group" style="flex: 1; display: flex; align-items: flex-end; padding-bottom: 0.8rem;">
       <label class="form-checkbox">
        <%= f.check_box :checked %>
        <span>Pass / Done</span>
      </label>
    </div>
  </div>
  <div class="form-group">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_field :notes, class: "form-input", placeholder: "Observations..." %>
  </div>
  
  <div style="display: flex; justify-content: flex-end; margin-top: 0.5rem;">
    <button type="button" class="btn btn-danger-outline btn-sm" data-action="nested-form#remove">
      Remove Item
    </button>
  </div>
  
  <%= f.hidden_field :_destroy %>
</div>
