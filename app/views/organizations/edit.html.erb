<%= content_for :title, "Edit Organization - Kadibs" %>
<%= render "shared/form_styles" %>

<%= render "shared/account_tabs" %>

<div class="account-content">
  <div class="form-container">
    <%= form_with model: @organization, url: organization_path, method: :patch, class: "resource-form" do |f| %>
      <% if @organization.errors.any? %>
        <div class="form-errors">
          <h4><%= pluralize(@organization.errors.count, "error") %> prevented your settings from being saved</h4>
          <ul>
            <% @organization.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-section">
        <h3 class="form-section-title">Company Information</h3>
        
        <div class="form-row">
          <div class="form-group full">
            <%= f.label :name, class: "form-label" do %>
              Company Name <span class="required">*</span>
            <% end %>
            <%= f.text_field :name, class: "form-input", required: true %>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <%= f.label :domain, class: "form-label" do %>
              Domain
            <% end %>
            <%= f.text_field :domain, class: "form-input", placeholder: "example.com" %>
          </div>

          <div class="form-group">
            <%= f.label :website, class: "form-label" do %>
              Website
            <% end %>
            <%= f.url_field :website, class: "form-input", placeholder: "https://example.com" %>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3 class="form-section-title">Contact & Location</h3>
        
        <div class="form-row">
          <div class="form-group">
            <%= f.label :email, class: "form-label" do %>
              Contact Email
            <% end %>
            <%= f.email_field :email, class: "form-input", placeholder: "admin@example.com" %>
          </div>

          <div class="form-group">
            <%= f.label :phone, class: "form-label" do %>
              Phone Number
            <% end %>
            <%= f.telephone_field :phone, class: "form-input", placeholder: "+1 (555) 123-4567" %>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group full">
            <%= f.label :address, class: "form-label" do %>
              Address
            <% end %>
            <%= f.text_field :address, class: "form-input", placeholder: "123 Main St" %>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <%= f.label :city, class: "form-label" do %>
              City
            <% end %>
            <%= f.text_field :city, class: "form-input" %>
          </div>
          
          <div class="form-group">
            <%= f.label :state, class: "form-label" do %>
              State/Province
            <% end %>
            <%= f.text_field :state, class: "form-input" %>
          </div>
          
          <div class="form-group">
            <%= f.label :zip_code, class: "form-label" do %>
              Zip/Postal Code
            <% end %>
            <%= f.text_field :zip_code, class: "form-input" %>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <%= f.label :country, class: "form-label" do %>
              Country
            <% end %>
            <%= f.country_select :country, { priority_countries: ["US", "CA", "GB"] }, { class: "form-select" } rescue f.text_field :country, class: "form-input" %>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Cancel", organization_path, class: "btn btn-outline" %>
        <%= f.submit "Save Changes", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .account-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>
