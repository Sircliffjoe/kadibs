<%= content_for :title, "#{@work_order.title} - Kadibs" %>

<!-- Breadcrumb -->
<div class="wo-breadcrumb">
  <%= link_to "Work Orders", work_orders_path, class: "wo-breadcrumb-link" %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;color:#94a3b8;"><polyline points="9 18 15 12 9 6"/></svg>
  <span class="wo-breadcrumb-current"><%= @work_order.number %></span>
</div>

<!-- Premium Header Banner -->
<div class="wo-hero">
  <div class="wo-hero-bg"></div>
  <div class="wo-hero-content">
    <div class="wo-hero-left">
      <div class="wo-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </div>
      <div class="wo-hero-info">
        <h1 class="wo-hero-title"><%= @work_order.title %></h1>
        <div class="wo-hero-meta">
          <span class="wo-hero-code"><%= @work_order.number %></span>
          <% if @work_order.due_date.present? %>
            <span class="wo-hero-sep">•</span>
            <span class="wo-hero-due">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Due: <%= @work_order.due_date.strftime("%b %d, %Y") %>
            </span>
          <% end %>
          <% if @work_order.asset.present? %>
            <span class="wo-hero-sep">•</span>
            <span class="wo-hero-asset">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><rect x="2" y="6" width="20" height="12" rx="2"/></svg>
              <%= @work_order.asset.name %>
            </span>
          <% end %>
        </div>
        <div class="wo-hero-badges">
          <span class="wo-pill wo-pill-status wo-pill-<%= @work_order.status %>">
            <span class="wo-pill-dot"></span>
            <%= @work_order.status.titleize %>
          </span>
          <span class="wo-pill wo-pill-priority wo-pill-<%= @work_order.priority %>">
            <%= @work_order.priority&.titleize || 'Medium' %>
          </span>
          <% if @work_order.work_order_type.present? %>
            <span class="wo-pill wo-pill-type">
              <%= @work_order.work_order_type.titleize %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="wo-hero-actions">
      <% if policy(@work_order).update? %>
        <%= link_to edit_work_order_path(@work_order), class: "wo-action-btn wo-action-ghost" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        <% end %>
      <% end %>

      <% if @work_order.status == 'open' && policy(@work_order).start? %>
        <%= button_to start_work_order_path(@work_order), method: :post, class: "wo-action-btn wo-action-success" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Start Work
        <% end %>
      <% end %>

      <% if @work_order.status == 'in_progress' && policy(@work_order).pause? %>
        <%= button_to pause_work_order_path(@work_order), method: :post, class: "wo-action-btn wo-action-warning" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          Pause
        <% end %>
      <% end %>

      <% if @work_order.status == 'on_hold' && policy(@work_order).resume? %>
        <%= button_to resume_work_order_path(@work_order), method: :post, class: "wo-action-btn wo-action-success" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Resume
        <% end %>
      <% end %>

      <% if %w[in_progress assigned].include?(@work_order.status) && policy(@work_order).complete? %>
        <%= button_to complete_work_order_path(@work_order), method: :post, class: "wo-action-btn wo-action-primary" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><polyline points="20 6 9 17 4 12"/></svg>
          Complete
        <% end %>
      <% end %>

      <% if @work_order.status == 'completed' && policy(@work_order).close? %>
        <%= button_to close_work_order_path(@work_order), method: :post, class: "wo-action-btn wo-action-ghost" do %>
          Close Work Order
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="detail-layout">
  <!-- Main Content -->
  <div class="detail-main">
    <!-- Description Card -->
    <div class="detail-card">
      <h3 class="card-title">Description</h3>
      <div class="card-content">
        <p><%= @work_order.description.presence || "No description provided." %></p>
      </div>
    </div>

    <!-- Checklist -->
    <% if @checklists.any? %>
      <div class="detail-card">
        <h3 class="card-title">Checklists</h3>
        <div class="card-content">
          <% @checklists.each do |checklist| %>
            <div class="checklist-section">
              <h4><%= checklist.name %></h4>
              <div class="checklist-items">
                <% checklist.items.each do |item| %>
                  <div class="checklist-item <%= 'completed' if item.completed? %>">
                    <input type="checkbox" <%= 'checked' if item.completed? %> disabled>
                    <span><%= item.description %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Parts Used -->
    <div class="detail-card">
      <h3 class="card-title">Parts Used</h3>
      <div class="card-content">
        <% if @parts.any? %>
          <table class="mini-table">
            <thead>
              <tr><th>Part</th><th>Qty</th><th>Cost</th></tr>
            </thead>
            <tbody>
              <% @parts.each do |wop| %>
                <tr>
                  <td><%= wop.part&.name %></td>
                  <td><%= wop.quantity %></td>
                  <td>$<%= number_with_precision(wop.unit_cost.to_f * wop.quantity, precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty-message">No parts used yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Labor Entries -->
    <div class="detail-card">
      <h3 class="card-title">Labor</h3>
      <div class="card-content">
        <% if @labor_entries.any? %>
          <table class="mini-table">
            <thead>
              <tr><th>Technician</th><th>Hours</th><th>Date</th></tr>
            </thead>
            <tbody>
              <% @labor_entries.each do |labor| %>
                <tr>
                  <td><%= labor.user&.first_name %> <%= labor.user&.last_name %></td>
                  <td><%= labor.hours %></td>
                  <td><%= labor.work_date&.strftime("%b %d") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty-message">No labor entries recorded.</p>
        <% end %>
      </div>
    </div>

    <!-- Comments -->
    <div class="detail-card">
      <h3 class="card-title">Comments</h3>
      <div class="card-content">
        <% if @comments.any? %>
          <div class="comments-list">
            <% @comments.each do |comment| %>
              <div class="comment">
                <div class="comment-header">
                  <div class="user-avatar-small"><%= comment.user&.first_name&.first %><%= comment.user&.last_name&.first %></div>
                  <strong><%= comment.user&.first_name %> <%= comment.user&.last_name %></strong>
                  <span class="comment-time"><%= time_ago_in_words(comment.created_at) %> ago</span>
                </div>
                <div class="comment-body"><%= comment.content %></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="empty-message">No comments yet.</p>
        <% end %>
        
        <%= form_with url: work_order_work_order_comments_path(@work_order), class: "comment-form" do |f| %>
          <%= f.text_area :content, placeholder: "Add a comment...", rows: 2, class: "form-input" %>
          <%= f.submit "Add Comment", class: "btn btn-outline btn-sm" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="detail-sidebar">
    <!-- Details -->
    <div class="detail-card">
      <h3 class="card-title">Details</h3>
      <div class="detail-list">
        <div class="detail-item">
          <span class="detail-label">WO Number</span>
          <span class="detail-value font-mono"><%= @work_order.number %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Type</span>
          <span class="detail-value"><%= @work_order.work_order_type&.titleize || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Due Date</span>
          <span class="detail-value <%= 'text-danger' if @work_order.due_date && @work_order.due_date < Date.current %>">
            <%= @work_order.due_date&.strftime("%b %d, %Y") || '—' %>
          </span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Estimated Hours</span>
          <span class="detail-value"><%= @work_order.estimated_hours || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Created</span>
          <span class="detail-value"><%= @work_order.created_at.strftime("%b %d, %Y") %></span>
        </div>
      </div>
    </div>

    <!-- Asset -->
    <% if @work_order.asset %>
      <div class="detail-card">
        <h3 class="card-title">Asset</h3>
        <div class="linked-item">
          <%= link_to @work_order.asset do %>
            <div class="linked-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
            </div>
            <div class="linked-item-info">
              <span class="linked-item-name"><%= @work_order.asset.name %></span>
              <span class="linked-item-sub"><%= @work_order.asset.code %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Assigned To -->
    <div class="detail-card">
      <h3 class="card-title">Assigned To</h3>
      <% if @work_order.assigned_to %>
        <div class="user-profile">
          <div class="user-avatar-large"><%= @work_order.assigned_to.first_name&.first %><%= @work_order.assigned_to.last_name&.first %></div>
          <div class="user-profile-info">
            <span class="user-profile-name"><%= @work_order.assigned_to.first_name %> <%= @work_order.assigned_to.last_name %></span>
            <span class="user-profile-role"><%= @work_order.assigned_to.job_title || 'Technician' %></span>
          </div>
        </div>
      <% else %>
        <p class="empty-message">Not assigned</p>
        <% if policy(@work_order).assign? %>
          <button class="btn btn-outline btn-sm btn-block">Assign Technician</button>
        <% end %>
      <% end %>
    </div>

    <!-- Location -->
    <% if @work_order.location %>
      <div class="detail-card">
        <h3 class="card-title">Location</h3>
        <div class="linked-item">
          <%= link_to @work_order.location do %>
            <div class="linked-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="linked-item-info">
              <span class="linked-item-name"><%= @work_order.location.name %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/detail_styles" %>

<style>
  /* ─── WO Breadcrumb ─── */
  .wo-breadcrumb { display: flex; align-items: center; gap: 0.35rem; margin-bottom: 1rem; font-size: 0.85rem; }
  .wo-breadcrumb-link { color: #6366f1; text-decoration: none; font-weight: 500; }
  .wo-breadcrumb-link:hover { text-decoration: underline; }
  .wo-breadcrumb-current { color: #64748b; font-family: 'SF Mono', 'Fira Code', monospace; }

  /* ─── WO Hero Banner ─── */
  .wo-hero { position: relative; border-radius: 16px; overflow: hidden; margin-bottom: 1.5rem; }
  .wo-hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 40%, #312e81 100%);
  }
  .wo-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 80% 20%, rgba(99,102,241,0.15) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 80%, rgba(139,92,246,0.10) 0%, transparent 60%);
  }
  .wo-hero-content {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between;
    padding: 2rem 2.25rem; gap: 2rem;
  }
  .wo-hero-left { display: flex; align-items: center; gap: 1.5rem; flex: 1; min-width: 0; }

  .wo-hero-icon {
    width: 64px; height: 64px; border-radius: 16px;
    background: linear-gradient(135deg, rgba(99,102,241,0.25), rgba(139,92,246,0.25));
    border: 1px solid rgba(255,255,255,0.12);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: #a5b4fc; backdrop-filter: blur(8px);
  }
  .wo-hero-icon svg { width: 32px; height: 32px; }

  .wo-hero-info { min-width: 0; flex: 1; }
  .wo-hero-title { font-size: 1.5rem; font-weight: 700; color: #f8fafc; margin: 0 0 0.35rem; letter-spacing: -0.02em; line-height: 1.2; }
  .wo-hero-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; font-size: 0.82rem; color: #94a3b8; }
  .wo-hero-code { font-family: 'SF Mono', 'Fira Code', monospace; color: #a5b4fc; background: rgba(99,102,241,0.12); padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.78rem; font-weight: 500; }
  .wo-hero-sep { color: #475569; }
  .wo-hero-due, .wo-hero-asset { display: inline-flex; align-items: center; gap: 0.25rem; color: #cbd5e1; }

  /* ─── WO Badges ─── */
  .wo-hero-badges { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .wo-pill { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
  .wo-pill-dot { width: 7px; height: 7px; border-radius: 50%; }

  .wo-pill-open { background: rgba(59,130,246,0.15); color: #60a5fa; }
  .wo-pill-open .wo-pill-dot { background: #60a5fa; }
  .wo-pill-in_progress { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .wo-pill-in_progress .wo-pill-dot { background: #fbbf24; }
  .wo-pill-completed { background: rgba(34,197,94,0.15); color: #4ade80; }
  .wo-pill-completed .wo-pill-dot { background: #4ade80; }
  .wo-pill-on_hold { background: rgba(249,115,22,0.15); color: #fdba74; }
  .wo-pill-on_hold .wo-pill-dot { background: #fdba74; }
  .wo-pill-closed { background: rgba(148,163,184,0.15); color: #94a3b8; }
  .wo-pill-closed .wo-pill-dot { background: #94a3b8; }
  .wo-pill-assigned { background: rgba(139,92,246,0.15); color: #c4b5fd; }
  .wo-pill-assigned .wo-pill-dot { background: #c4b5fd; }

  .wo-pill-priority { background: rgba(148,163,184,0.12); color: #cbd5e1; border: 1px solid rgba(148,163,184,0.2); }
  .wo-pill-critical { background: rgba(239,68,68,0.12); color: #fca5a5; border-color: rgba(239,68,68,0.25); }
  .wo-pill-high { background: rgba(249,115,22,0.12); color: #fdba74; border-color: rgba(249,115,22,0.25); }
  .wo-pill-medium { background: rgba(251,191,36,0.12); color: #fde68a; border-color: rgba(251,191,36,0.25); }
  .wo-pill-low { background: rgba(34,197,94,0.12); color: #86efac; border-color: rgba(34,197,94,0.25); }
  .wo-pill-type { background: rgba(99,102,241,0.12); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.2); }

  /* ─── WO Action Buttons ─── */
  .wo-hero-actions { display: flex; gap: 0.75rem; align-items: center; flex-shrink: 0; flex-wrap: wrap; }
  .wo-action-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.6rem 1.25rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600;
    text-decoration: none; cursor: pointer; transition: all 0.2s ease; white-space: nowrap; border: none;
  }
  .wo-action-primary { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; box-shadow: 0 2px 8px rgba(99,102,241,0.3); }
  .wo-action-primary:hover { box-shadow: 0 4px 16px rgba(99,102,241,0.45); transform: translateY(-1px); }
  .wo-action-ghost { background: rgba(255,255,255,0.08); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(4px); }
  .wo-action-ghost:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.25); color: white; }
  .wo-action-success { background: rgba(34,197,94,0.2); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
  .wo-action-success:hover { background: rgba(34,197,94,0.3); }
  .wo-action-warning { background: rgba(251,191,36,0.2); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); }
  .wo-action-warning:hover { background: rgba(251,191,36,0.3); }

  @media (max-width: 768px) {
    .wo-hero-content { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
    .wo-hero-left { flex-direction: column; align-items: flex-start; }
    .wo-hero-actions { width: 100%; }
    .wo-action-btn { flex: 1; justify-content: center; }
  }
</style>
