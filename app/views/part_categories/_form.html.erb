<%= form_with model: part_category, class: "resource-form" do |f| %>
  <div class="form-section">
    <div class="form-section-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
      </svg>
      Part Category Details
    </div>

    <%= render "shared/form_errors", resource: part_category %>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :name, class: "form-label" do %>
          Category Name <span class="required">*</span>
        <% end %>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g., Bearings & Seals", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :code, class: "form-label" do %>
          Category Code
        <% end %>
        <%= f.text_field :code, class: "form-input", placeholder: "e.g., BRG" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group full">
        <%= f.label :parent_id, "Parent Category", class: "form-label" %>
        <%= f.collection_select :parent_id, PartCategory.where.not(id: part_category.id).order(:name), :id, :name, { include_blank: "No Parent (Root Category)" }, class: "form-select" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group full">
        <%= f.label :description, class: "form-label" %>
        <%= f.text_area :description, class: "form-input", placeholder: "Optional description...", rows: 3 %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", part_categories_path, class: "btn btn-outline" %>
    <%= f.submit part_category.new_record? ? "Create Category" : "Save Changes", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "shared/form_styles" %>
