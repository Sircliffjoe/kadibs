<%= content_for :title, "Warehouses - Kadibs" %>

<div class="page-header">
  <div class="page-header-content">
    <h1>Warehouses</h1>
    <p class="page-subtitle">Manage inventory storage locations</p>
  </div>
  <div class="page-actions">
    <%= link_to new_warehouse_path, class: "btn btn-primary" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add Warehouse
    <% end %>
  </div>
</div>

<div class="data-table-container">
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Location</th>
        <th>Default</th>
        <th>Stock Locations</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @warehouses.any? %>
        <% @warehouses.each do |warehouse| %>
          <tr>
            <td><%= link_to warehouse.name, warehouse, class: "table-link" %></td>
            <td>
              <% if warehouse.location %>
                <%= link_to warehouse.location.name, warehouse.location, class: "secondary-link" %>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td>
              <% if warehouse.default_warehouse %>
                <span class="status-badge status-active">Default</span>
              <% end %>
            </td>
            <td><%= warehouse.stock_locations.count %></td>
            <td>
              <div class="table-actions">
                <%= link_to warehouse, class: "action-btn", title: "View" do %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <% end %>
                <%= link_to edit_warehouse_path(warehouse), class: "action-btn", title: "Edit" do %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="empty-table">
            <div class="empty-state">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="empty-icon">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              </svg>
              <p>No warehouses found</p>
              <%= link_to "Add your first warehouse", new_warehouse_path, class: "btn btn-primary" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/table_styles" %>
