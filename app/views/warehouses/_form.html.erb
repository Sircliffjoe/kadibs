<%= render "shared/form_styles" %>

<%= form_with(model: warehouse, local: true, class: "resource-form") do |f| %>
  <% if warehouse.errors.any? %>
    <div class="form-errors">
      <h4><%= pluralize(warehouse.errors.count, "error") %> prevented saving:</h4>
      <ul>
        <% warehouse.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-title">
      <h3>Warehouse Details</h3>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <%= f.label :name, "Warehouse Name *", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g. Central Storage" %>
      </div>
      
      <div class="form-group">
        <%= f.label :code, "Code", class: "form-label" %>
        <%= f.text_field :code, class: "form-input", placeholder: "Auto-generated if empty" %>
      </div>

      <div class="form-group">
        <%= f.label :location_id, "Physical Location", class: "form-label" %>
        <%= f.collection_select :location_id, Location.order(:name), :id, :name, { prompt: "Select Location" }, { class: "form-select" } %>
      </div>
      
      <div class="form-group">
        <%= f.label :manager_id, "Manager", class: "form-label" %>
        <%= f.collection_select :manager_id, User.order(:first_name), :id, :full_name, { prompt: "Select Manager" }, { class: "form-select" } %>
      </div>
      
      <div class="form-group full">
        <%= f.label :description, class: "form-label" %>
        <%= f.text_area :description, class: "form-input", rows: 3 %>
      </div>
      
      <div class="form-group full">
        <label class="checkbox-label">
          <%= f.check_box :default_warehouse, class: "form-checkbox" %>
          <span>Set as Default Warehouse</span>
        </label>
        <p class="form-help">This will unset any current default warehouse.</p>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", warehouses_path, class: "btn btn-outline" %>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
