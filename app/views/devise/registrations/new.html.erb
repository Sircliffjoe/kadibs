<%= content_for :title, "Sign Up - Kadibs" %>

<div class="auth-page">
  <!-- Navigation Header -->
  <nav class="auth-nav">
    <div class="nav-container">
      <%= link_to root_path, class: "logo" do %>
        <svg class="logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" fill="url(#nav-gradient)"/>
          <path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <defs>
            <linearGradient id="nav-gradient" x1="0" y1="0" x2="32" y2="32">
              <stop stop-color="var(--primary)"/>
              <stop offset="1" stop-color="var(--primary-light)"/>
            </linearGradient>
          </defs>
        </svg>
        <span class="logo-text">Kadibs</span>
      <% end %>
      <div class="nav-links">
        <%= link_to "Home", root_path, class: "nav-link" %>
        <%= link_to "Sign In", new_user_session_path, class: "btn btn-outline-nav" %>
      </div>
    </div>
  </nav>

  <div class="auth-container">
    <!-- Auth Card -->
    <div class="auth-card">
      <h1 class="auth-title">Create your account</h1>
      <p class="auth-subtitle">It only takes a minute.</p>

      <!-- Error Messages -->
      <% if resource.errors.any? %>
        <div class="alert alert-error">
          <ul>
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <!-- Organization Name -->
        <div class="form-group">
          <%= f.label :organization_name, "Organization Name", class: "form-label" %>
          <%= f.text_field :organization_name, 
              class: "form-input", 
              placeholder: "Your company name",
              autofocus: true %>
        </div>

        <!-- Name Fields -->
        <div class="form-row">
          <div class="form-group">
            <%= f.label :first_name, class: "form-label" %>
            <%= f.text_field :first_name, 
                class: "form-input", 
                placeholder: "First name" %>
          </div>
          <div class="form-group">
            <%= f.label :last_name, class: "form-label" %>
            <%= f.text_field :last_name, 
                class: "form-input", 
                placeholder: "Last name" %>
          </div>
        </div>

        <!-- Email -->
        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, 
              class: "form-input", 
              placeholder: "work@company.com",
              autocomplete: "email" %>
        </div>

        <!-- Phone -->
        <div class="form-group">
          <%= f.label :phone, "Phone Number", class: "form-label" %>
          <%= f.text_field :phone, 
              class: "form-input", 
              placeholder: "+1 (555) 000-0000" %>
        </div>

        <!-- Password -->
        <div class="form-group">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, 
              class: "form-input", 
              placeholder: "Create a strong password",
              autocomplete: "new-password" %>
          <% if @minimum_password_length %>
            <span class="form-hint"><%= @minimum_password_length %> characters minimum</span>
          <% end %>
        </div>

        <!-- Password Confirmation -->
        <div class="form-group">
          <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
          <%= f.password_field :password_confirmation, 
              class: "form-input", 
              placeholder: "Confirm your password",
              autocomplete: "new-password" %>
        </div>

        <!-- Submit -->
        <%= f.submit "Create Account", class: "btn btn-primary btn-block" %>
      <% end %>

      <!-- Divider -->
      <div class="auth-divider">
        <span>or</span>
      </div>

      <!-- Social Login (placeholder) -->
      <button type="button" class="btn btn-social">
        <svg viewBox="0 0 24 24" class="social-icon">
          <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Continue with Google
      </button>

      <!-- Auth Links -->
      <div class="auth-links">
        <span>Already have an account?</span>
        <%= link_to "Sign in", new_session_path(resource_name), class: "auth-link" %>
      </div>
    </div>

    <!-- Terms -->
    <p class="auth-terms">
      By signing up, you agree to our 
      <%= link_to "Terms of Service", "#", class: "terms-link" %> and 
      <%= link_to "Privacy Policy", "#", class: "terms-link" %>.
    </p>
  </div>
</div>

<style>
  .auth-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
    display: flex;
    flex-direction: column;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  /* Navigation Header */
  .auth-nav {
    width: 100%;
    padding: 1rem 0;
    background: transparent;
  }

  .auth-nav .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .auth-nav .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .auth-nav .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .auth-nav .nav-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .auth-nav .nav-link:hover {
    color: white;
  }

  .btn-outline-nav {
    padding: 0.5rem 1.25rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-outline-nav:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .auth-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .auth-brand {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-brand .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-icon {
    width: 40px;
    height: 40px;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .auth-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 2.5rem;
    backdrop-filter: blur(10px);
  }

  .auth-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .auth-subtitle {
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .alert {
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
  }

  .alert ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .alert li {
    font-size: 0.9rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }

  .form-input {
    width: 100%;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: white;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .form-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--primary);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }

  .form-hint {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
    gap: 0.5rem;
  }

  .btn-primary {
    background: var(--primary-gradient);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4);
  }

  .btn-block {
    width: 100%;
    margin-top: 0.5rem;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.875rem;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
  }

  .btn-social {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: white;
  }

  .btn-social:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .social-icon {
    width: 20px;
    height: 20px;
  }

  .auth-links {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .auth-link {
    color: #818cf8;
    text-decoration: none;
    font-weight: 500;
    margin-left: 0.25rem;
  }

  .auth-link:hover {
    color: #a5b4fc;
    text-decoration: underline;
  }

  .auth-terms {
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 1.5rem;
    line-height: 1.6;
  }

  .terms-link {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: underline;
  }

  .terms-link:hover {
    color: white;
  }

  @media (max-width: 480px) {
    .auth-page {
      padding: 1rem;
    }

    .auth-card {
      padding: 1.5rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
