<%= content_for :title, "Sign In - Kadibs" %>

<div class="landing-page inner-page auth-page-wrapper">
  <%= render "shared/public_header" %>

  <div class="auth-container">
    <!-- Auth Card -->
    <div class="auth-card">
      <h1 class="auth-title">Welcome back</h1>
      <p class="auth-subtitle">Sign in to your Kadibs account</p>

      <!-- Flash Messages -->
      <% if flash[:alert] %>
        <div class="alert alert-error">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert alert-success">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <!-- Email -->
        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, 
              class: "form-input", 
              placeholder: "Enter your email",
              autocomplete: "email",
              autofocus: true %>
        </div>

        <!-- Password -->
        <div class="form-group">
          <div class="label-row">
            <%= f.label :password, class: "form-label" %>
            <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "forgot-link" %>
            <% end %>
          </div>
          <%= f.password_field :password, 
              class: "form-input", 
              placeholder: "Enter your password",
              autocomplete: "current-password" %>
        </div>

        <!-- Remember Me -->
        <% if devise_mapping.rememberable? %>
          <div class="form-checkbox">
            <%= f.check_box :remember_me, class: "checkbox-input" %>
            <%= f.label :remember_me, "Keep me signed in", class: "checkbox-label" %>
          </div>
        <% end %>

        <!-- Submit -->
        <button type="submit" class="btn btn-primary btn-block btn-lg">Sign In</button>
      <% end %>
    </div>
  </div>

  <%= render "shared/footer" %>
</div>


<style>
  .auth-page-wrapper {
    min-height: 100vh;
    background-color: var(--light);
    display: flex;
    flex-direction: column;
  }

  .auth-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .auth-card {
    background: var(--white);
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
    width: 100%;
    max-width: 450px;
    border: 1px solid var(--gray-200);
  }

  .auth-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .auth-subtitle {
    color: var(--dark-muted);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .form-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--dark-muted);
  }

  .form-input {
    padding: 0.875rem 1rem;
    border: 1px solid var(--gray-200);
    border-radius: 8px;
    font-size: 1rem;
    background: var(--light);
    transition: all 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--primary);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(29, 53, 87, 0.1);
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .forgot-link {
    font-size: 0.85rem;
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
  }

  .form-checkbox {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .checkbox-label {
    font-size: 0.9rem;
    color: var(--dark-muted);
  }

  .btn-block {
    width: 100%;
  }

  .alert {
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-weight: 500;
    text-align: center;
  }

  .alert-error {
    background: #fee2e2;
    color: #991b1b;
  }

  .alert-success {
    background: #dcfce7;
    color: #166534;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
