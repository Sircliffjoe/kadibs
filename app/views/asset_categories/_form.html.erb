<%= form_with model: asset_category, class: "resource-form" do |f| %>
  <div class="form-section">
    <div class="form-section-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
        <path d="M4 6h16M4 12h16M4 18h7"/>
      </svg>
      Category Information
    </div>

    <%= render "shared/form_errors", resource: asset_category %>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :name, class: "form-label" do %>
          Category Name <span class="required">*</span>
        <% end %>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g., Heavy Machinery", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :code, class: "form-label" do %>
          Category Code <span class="required">*</span>
        <% end %>
        <%= f.text_field :code, class: "form-input", placeholder: "e.g., HM01", required: true %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group full">
        <%= f.label :parent_id, "Parent Category", class: "form-label" %>
        <%= f.collection_select :parent_id, AssetCategory.where.not(id: asset_category.id).order(:name), :id, :name, { include_blank: "No Parent (Root Category)" }, class: "form-select" %>
        <span class="form-help">Choose a parent if this is a sub-category</span>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group full">
        <%= f.label :description, class: "form-label" %>
        <%= f.text_area :description, class: "form-input", placeholder: "Optional description of what this category covers...", rows: 3 %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", asset_categories_path, class: "btn btn-outline" %>
    <%= f.submit asset_category.new_record? ? "Create Category" : "Save Changes", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "shared/form_styles" %>
