<%= render "shared/form_styles" %>

<%= form_with(model: pm_schedule, url: pm_schedule.persisted? ? pm_schedule_path(pm_schedule) : pm_schedules_path, local: true, class: "resource-form") do |f| %>
  <% if pm_schedule.errors.any? %>
    <div class="form-errors">
      <h4><%= pluralize(pm_schedule.errors.count, "error") %> prevented saving:</h4>
      <ul>
        <% pm_schedule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-title">
      <h3>Basic Information</h3>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <%= f.label :name, "Schedule Name *", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g. Monthly HVAC Inspection" %>
      </div>
      
      <div class="form-group">
        <%= f.label :asset_id, "Asset *", class: "form-label" %>
        <%= f.collection_select :asset_id, Asset.order(:name), :id, :name, { prompt: "Select Asset" }, { class: "form-select" } %>
      </div>
      
      <div class="form-group full">
        <%= f.label :description, class: "form-label" %>
        <%= f.text_area :description, class: "form-input", rows: 3 %>
      </div>

      <div class="form-group">
        <%= f.label :priority, class: "form-label" %>
        <%= f.select :priority, 
            PreventiveMaintenanceSchedule::PRIORITIES.map { |p| [p.titleize, p] }, 
            {}, class: "form-select" %>
      </div>

      <div class="form-group">
        <%= f.label :default_assignee_id, "Default Assignee", class: "form-label" %>
        <%= f.collection_select :default_assignee_id, User.order(:first_name), :id, :full_name_email, { prompt: "Unassigned" }, { class: "form-select" } %>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">
      <h3>Schedule Settings</h3>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <%= f.label :schedule_type, "Schedule Type *", class: "form-label" %>
        <%= f.select :schedule_type, 
            PreventiveMaintenanceSchedule::SCHEDULE_TYPES.map { |t| [t.humanize, t] }, 
            {}, class: "form-select", 
            data: { controller: "toggle", action: "change->toggle#toggle" } %>
      </div>

      <div class="form-group">
        <%= f.label :frequency_value, "Frequency Interval", class: "form-label" %>
        <div class="input-group">
          <%= f.number_field :frequency_value, class: "form-input", min: 1 %>
          <%= f.select :frequency_unit, 
              PreventiveMaintenanceSchedule::FREQUENCY_UNITS.map { |u| [u.titleize, u] }, 
              {}, class: "form-select" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :next_due_date, "Next Due Date *", class: "form-label" %>
        <%= f.date_field :next_due_date, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :estimated_hours, "Est. Hours", class: "form-label" %>
        <%= f.number_field :estimated_hours, class: "form-input", step: 0.5, min: 0 %>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">
      <h3>Instructions & Safety</h3>
    </div>
    
    <div class="form-row">
      <div class="form-group full">
        <%= f.label :instructions, "Maintenance Instructions", class: "form-label" %>
        <%= f.text_area :instructions, class: "form-input", rows: 4 %>
      </div>
      
      <div class="form-group full">
        <%= f.label :safety_notes, "Safety Notes", class: "form-label" %>
        <%= f.text_area :safety_notes, class: "form-input", rows: 2, placeholder: "e.g. Lockout/Tagout required" %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", pm_schedules_path, class: "btn btn-outline" %>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
