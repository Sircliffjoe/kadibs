<%= content_for :title, "Equipment - Kadibs" %>

<div class="page-header">
  <div class="page-header-content">
    <h1>Equipment</h1>
    <p class="page-subtitle">Manage your assets and equipment</p>
  </div>
  <div class="page-actions">
    <% if policy(AssetCategory).index? %>
      <%= link_to asset_categories_path, class: "btn btn-outline", style: "margin-right: 0.75rem;" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
          <path d="M4 6h16M4 12h16M4 18h7"/>
        </svg>
        Manage Categories
      <% end %>
    <% end %>
    <%= link_to new_asset_path, class: "btn btn-primary" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add Equipment
    <% end %>
  </div>
</div>

<!-- Filters -->
<div class="filters-bar">
  <%= form_with url: assets_path, method: :get, class: "filters-form", data: { turbo_frame: "_top" } do |f| %>
    <div class="filter-group">
      <%= f.text_field :search, value: params[:search], placeholder: "Search equipment...", class: "filter-input" %>
    </div>
    <div class="filter-group">
      <%= f.select :status, options_for_select([
        ["All Statuses", ""],
        ["Operational", "operational"],
        ["Under Maintenance", "under_maintenance"],
        ["Out of Service", "out_of_service"],
        ["Retired", "retired"]
      ], params[:status]), {}, class: "filter-select" %>
    </div>
    <div class="filter-group">
      <%= f.select :criticality, options_for_select([
        ["All Criticality", ""],
        ["Low", "low"],
        ["Medium", "medium"],
        ["High", "high"],
        ["Critical", "critical"]
      ], params[:criticality]), {}, class: "filter-select" %>
    </div>
    <div class="filter-group">
      <%= f.collection_select :category, AssetCategory.order(:name), :id, :name, 
          { include_blank: "All Categories" }, class: "filter-select" %>
    </div>
    <%= f.submit "Filter", class: "btn btn-outline" %>
    <%= link_to "Clear", assets_path, class: "btn btn-text" %>
  <% end %>
</div>

<!-- Stats Summary -->
<div class="stats-row">
  <div class="stat-pill">
    <span class="stat-pill-value"><%= @assets.count %></span>
    <span class="stat-pill-label">Total</span>
  </div>
  <div class="stat-pill">
    <span class="stat-pill-value"><%= @assets.where(status: 'operational').count %></span>
    <span class="stat-pill-label">Operational</span>
  </div>
  <div class="stat-pill stat-warning">
    <span class="stat-pill-value"><%= @assets.where(status: 'under_maintenance').count %></span>
    <span class="stat-pill-label">Under Maintenance</span>
  </div>
  <div class="stat-pill stat-danger">
    <span class="stat-pill-value"><%= @assets.where(criticality: 'critical').count %></span>
    <span class="stat-pill-label">Critical</span>
  </div>
</div>

<!-- Equipment Table -->
<div class="data-table-container">
  <table class="data-table">
    <thead>
      <tr>
        <th>Asset #</th>
        <th>Name</th>
        <th>Category</th>
        <th>Location</th>
        <th>Status</th>
        <th>Criticality</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @assets.any? %>
        <% @assets.each do |asset| %>
          <tr>
            <td class="font-mono"><%= asset.code %></td>
            <td>
              <%= link_to asset.name, asset, class: "table-link" %>
              <% if asset.manufacturer.present? %>
                <span class="secondary-link"><%= asset.manufacturer %> <%= asset.model %></span>
              <% end %>
            </td>
            <td>
              <% if asset.asset_category %>
                <span class="type-badge"><%= asset.asset_category.name %></span>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td>
              <% if asset.location %>
                <%= link_to asset.location.name, asset.location, class: "secondary-link" %>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td>
              <span class="status-badge status-<%= asset.status %>"><%= asset.status&.titleize %></span>
            </td>
            <td>
              <span class="priority-badge priority-<%= asset.criticality %>"><%= asset.criticality&.titleize || 'Medium' %></span>
            </td>
            <td>
              <div class="table-actions">
                <%= link_to asset, class: "action-btn", title: "View" do %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <% end %>
                <%= link_to edit_asset_path(asset), class: "action-btn", title: "Edit" do %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <% end %>
                <%= link_to new_work_order_path(asset_id: asset.id), class: "action-btn", title: "Create Work Order" do %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="7" class="empty-table">
            <div class="empty-state">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="empty-icon">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h4"/>
              </svg>
              <p>No equipment found</p>
              <%= link_to "Add your first equipment", new_asset_path, class: "btn btn-primary" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy && @pagy.pages > 1 %>
  <div class="pagination-container">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>

<%= render "shared/table_styles" %>

<style>
  .status-operational { background: #dcfce7; color: #166534; }
  .status-under_maintenance { background: #fef3c7; color: #b45309; }
  .status-out_of_service { background: #fee2e2; color: #b91c1c; }
  .status-retired { background: #f1f5f9; color: #64748b; }
</style>
