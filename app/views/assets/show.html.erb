<%= content_for :title, "#{@asset.name} - Kadibs" %>

<!-- Breadcrumb -->
<div class="asset-breadcrumb">
  <%= link_to "Equipment", assets_path, class: "asset-breadcrumb-link" %> 
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;color:#94a3b8;"><polyline points="9 18 15 12 9 6"/></svg>
  <span class="asset-breadcrumb-current"><%= @asset.code %></span>
</div>

<!-- Premium Header Banner -->
<div class="asset-hero">
  <div class="asset-hero-bg"></div>
  <div class="asset-hero-content">
    <div class="asset-hero-left">
      <div class="asset-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="6" width="20" height="12" rx="2"/>
          <path d="M12 6V4"/>
          <path d="M8 6V4"/>
          <path d="M16 6V4"/>
          <circle cx="7" cy="12" r="1.5"/>
          <circle cx="17" cy="12" r="1.5"/>
          <path d="M10 12h4"/>
        </svg>
      </div>
      <div class="asset-hero-info">
        <h1 class="asset-hero-title"><%= @asset.name %></h1>
        <div class="asset-hero-meta">
          <span class="asset-hero-code"><%= @asset.code %></span>
          <% if @asset.serial_number.present? %>
            <span class="asset-hero-sep">•</span>
            <span class="asset-hero-serial">S/N: <%= @asset.serial_number %></span>
          <% end %>
          <% if @asset.location.present? %>
            <span class="asset-hero-sep">•</span>
            <span class="asset-hero-location">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <%= @asset.location.name %>
            </span>
          <% end %>
        </div>
        <div class="asset-hero-badges">
          <span class="asset-pill asset-pill-status asset-pill-<%= @asset.status %>">
            <span class="asset-pill-dot"></span>
            <%= @asset.status&.titleize %>
          </span>
          <span class="asset-pill asset-pill-criticality asset-pill-<%= @asset.criticality %>">
            <%= @asset.criticality&.titleize || 'Medium' %> Criticality
          </span>
          <% if @asset.asset_category.present? %>
            <span class="asset-pill asset-pill-category">
              <%= @asset.asset_category.name %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="asset-hero-actions">
      <%= link_to new_work_order_path(asset_id: @asset.id), class: "asset-action-btn asset-action-primary" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        Create Work Order
      <% end %>
      <%= link_to edit_asset_path(@asset), class: "asset-action-btn asset-action-ghost" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Edit
      <% end %>
    </div>
  </div>
</div>

<div class="detail-layout">
  <!-- Main Content -->
  <div class="detail-main">
    <!-- Description -->
    <div class="detail-card">
      <h3 class="card-title">Description</h3>
      <div class="card-content">
        <p><%= @asset.description.presence || "No description provided." %></p>
      </div>
    </div>

    <!-- Recent Work Orders -->
    <div class="detail-card">
      <h3 class="card-title">Recent Work Orders</h3>
      <div class="card-content">
        <% if @work_orders.any? %>
          <table class="mini-table">
            <thead>
              <tr><th>WO #</th><th>Title</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
              <% @work_orders.each do |wo| %>
                <tr>
                  <td class="font-mono"><%= link_to wo.number, wo, class: "table-link" %></td>
                  <td><%= wo.title %></td>
                  <td><span class="status-badge status-<%= wo.status %>"><%= wo.status.titleize %></span></td>
                  <td><%= wo.created_at.strftime("%b %d") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty-message">No work orders for this asset.</p>
        <% end %>
        <%= link_to "View All Work Orders", work_orders_asset_path(@asset), class: "btn btn-outline btn-sm" if @work_orders.any? %>
      </div>
    </div>

    <!-- Maintenance History -->
    <div class="detail-card">
      <h3 class="card-title">Maintenance History</h3>
      <div class="card-content">
        <% if @maintenance_history.any? %>
          <div class="timeline">
            <% @maintenance_history.each do |wo| %>
              <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                  <span class="timeline-date"><%= wo.completed_at&.strftime("%b %d, %Y") %></span>
                  <strong><%= wo.title %></strong>
                  <span class="type-badge"><%= wo.work_order_type&.titleize %></span>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="empty-message">No maintenance history.</p>
        <% end %>
      </div>
    </div>

    <!-- Meter Readings -->
    <% if @meter_readings.any? %>
      <div class="detail-card">
        <h3 class="card-title">Meter Readings</h3>
        <div class="card-content">
          <table class="mini-table">
            <thead>
              <tr><th>Date</th><th>Value</th><th>Type</th></tr>
            </thead>
            <tbody>
              <% @meter_readings.each do |reading| %>
                <tr>
                  <td><%= reading.reading_date.strftime("%b %d, %Y") %></td>
                  <td><%= number_with_delimiter(reading.value) %></td>
                  <td><%= reading.meter_type&.titleize %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Sidebar -->
  <div class="detail-sidebar">
    <!-- Asset Details -->
    <div class="detail-card">
      <h3 class="card-title">Asset Details</h3>
      <div class="detail-list">
        <div class="detail-item">
          <span class="detail-label">Asset Number</span>
          <span class="detail-value font-mono"><%= @asset.code %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Serial Number</span>
          <span class="detail-value"><%= @asset.serial_number || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Manufacturer</span>
          <span class="detail-value"><%= @asset.manufacturer || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Model</span>
          <span class="detail-value"><%= @asset.model || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Purchase Date</span>
          <span class="detail-value"><%= @asset.purchase_date&.strftime("%b %d, %Y") || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Purchase Cost</span>
          <span class="detail-value">
            <% if @asset.purchase_price %>
              $<%= number_with_delimiter(@asset.purchase_price) %>
            <% else %>
              —
            <% end %>
          </span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Warranty Expires</span>
          <span class="detail-value <%= 'text-danger' if @asset.warranty_end_date && @asset.warranty_end_date < Date.current %>">
            <%= @asset.warranty_end_date&.strftime("%b %d, %Y") || '—' %>
          </span>
        </div>
      </div>
    </div>

    <!-- Category -->
    <% if @asset.asset_category %>
      <div class="detail-card">
        <h3 class="card-title">Category</h3>
        <div class="linked-item">
          <div class="linked-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div class="linked-item-info">
            <span class="linked-item-name"><%= @asset.asset_category.name %></span>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Location -->
    <% if @asset.location %>
      <div class="detail-card">
        <h3 class="card-title">Location</h3>
        <div class="linked-item">
          <%= link_to @asset.location do %>
            <div class="linked-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="linked-item-info">
              <span class="linked-item-name"><%= @asset.location.name %></span>
              <span class="linked-item-sub"><%= @asset.location.address %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Quick Actions -->
    <div class="detail-card">
      <h3 class="card-title">Quick Actions</h3>
      <div class="quick-actions">
        <!-- Update Meter -->
        <button type="button" class="qa-btn" onclick="document.getElementById('meter-form').classList.toggle('qa-hidden')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Update Meter
        </button>
        <div id="meter-form" class="qa-form qa-hidden">
          <%= form_with url: update_meter_asset_path(@asset), method: :post, class: "qa-form-inner" do |f| %>
            <div class="qa-field">
              <label class="qa-label">Reading Value</label>
              <input type="number" name="value" step="0.1" required class="qa-input" placeholder="e.g. 1250">
            </div>
            <div class="qa-field">
              <label class="qa-label">Meter Type</label>
              <select name="meter_type" class="qa-input">
                <option value="hours">Hours</option>
                <option value="miles">Miles</option>
                <option value="kilometers">Kilometers</option>
                <option value="cycles">Cycles</option>
              </select>
            </div>
            <%= f.submit "Save Reading", class: "qa-submit" %>
          <% end %>
        </div>

        <!-- Transfer Asset -->
        <button type="button" class="qa-btn" onclick="document.getElementById('transfer-form').classList.toggle('qa-hidden')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><polyline points="15 3 21 3 21 9"/><line x1="21" y1="3" x2="14" y2="10"/><polyline points="9 21 3 21 3 15"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          Transfer Asset
        </button>
        <div id="transfer-form" class="qa-form qa-hidden">
          <%= form_with url: transfer_asset_path(@asset), method: :post, class: "qa-form-inner" do |f| %>
            <div class="qa-field">
              <label class="qa-label">New Location</label>
              <%= f.collection_select :location_id, Location.order(:name), :id, :name, { prompt: "Select location..." }, class: "qa-input", required: true %>
            </div>
            <div class="qa-field">
              <label class="qa-label">Notes (optional)</label>
              <input type="text" name="notes" class="qa-input" placeholder="Reason for transfer">
            </div>
            <%= f.submit "Transfer", class: "qa-submit" %>
          <% end %>
        </div>

        <!-- Print QR Code -->
        <button type="button" class="qa-btn" onclick="printQR()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><line x1="20" y1="14" x2="20" y2="20"/><line x1="14" y1="20" x2="20" y2="20"/></svg>
          Print QR Code
        </button>
      </div>
    </div>

    <script>
      function printQR() {
        var qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=" + encodeURIComponent(window.location.href);
        var win = window.open('', '_blank', 'width=400,height=500');
        win.document.write(
          '<html><head><title>QR Code - <%= j @asset.name %></title>' +
          '<style>body{font-family:system-ui,sans-serif;text-align:center;padding:2rem;}' +
          'h2{font-size:1.2rem;color:#1e293b;margin-bottom:0.5rem;}' +
          'p{color:#64748b;font-size:0.85rem;margin:0.25rem 0;}' +
          '.code{font-family:monospace;color:#6366f1;font-weight:600;font-size:1rem;}' +
          'img{margin:1.5rem 0;}' +
          '@media print{button{display:none!important;}}</style></head><body>' +
          '<h2><%= j @asset.name %></h2>' +
          '<p class="code"><%= j @asset.code %></p>' +
          '<% if @asset.serial_number.present? %><p>S/N: <%= j @asset.serial_number %></p><% end %>' +
          '<img src="' + qrUrl + '" alt="QR Code"/>' +
          '<br><button onclick="window.print()" style="padding:0.5rem 1.5rem;border:1px solid #e2e8f0;border-radius:8px;background:#f8fafc;cursor:pointer;font-weight:600;">Print</button>' +
          '</body></html>'
        );
        win.document.close();
      }
    </script>
  </div>
</div>

<%= render "shared/detail_styles" %>

<style>
  /* ─── Breadcrumb ─── */
  .asset-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }
  .asset-breadcrumb-link {
    color: #6366f1;
    text-decoration: none;
    font-weight: 500;
  }
  .asset-breadcrumb-link:hover { text-decoration: underline; }
  .asset-breadcrumb-current {
    color: #64748b;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  /* ─── Hero Banner ─── */
  .asset-hero {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .asset-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 40%, #312e81 100%);
    z-index: 0;
  }
  .asset-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 20%, rgba(99,102,241,0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 20% 80%, rgba(139,92,246,0.10) 0%, transparent 60%);
  }
  .asset-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 2.25rem;
    gap: 2rem;
  }
  .asset-hero-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
    min-width: 0;
  }

  /* ─── Hero Icon ─── */
  .asset-hero-icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(99,102,241,0.25), rgba(139,92,246,0.25));
    border: 1px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #a5b4fc;
    backdrop-filter: blur(8px);
  }
  .asset-hero-icon svg {
    width: 32px;
    height: 32px;
  }

  /* ─── Hero Info ─── */
  .asset-hero-info {
    min-width: 0;
    flex: 1;
  }
  .asset-hero-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 0.35rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .asset-hero-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
    color: #94a3b8;
  }
  .asset-hero-code {
    font-family: 'SF Mono', 'Fira Code', monospace;
    color: #a5b4fc;
    background: rgba(99,102,241,0.12);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 500;
  }
  .asset-hero-serial { color: #cbd5e1; }
  .asset-hero-sep { color: #475569; }
  .asset-hero-location {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: #cbd5e1;
  }

  /* ─── Badges / Pills ─── */
  .asset-hero-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .asset-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .asset-pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  /* Status variants */
  .asset-pill-operational {
    background: rgba(34,197,94,0.15);
    color: #4ade80;
  }
  .asset-pill-operational .asset-pill-dot { background: #4ade80; }

  .asset-pill-under_maintenance {
    background: rgba(251,191,36,0.15);
    color: #fbbf24;
  }
  .asset-pill-under_maintenance .asset-pill-dot { background: #fbbf24; }

  .asset-pill-out_of_service {
    background: rgba(239,68,68,0.15);
    color: #f87171;
  }
  .asset-pill-out_of_service .asset-pill-dot { background: #f87171; }

  .asset-pill-retired {
    background: rgba(148,163,184,0.15);
    color: #94a3b8;
  }
  .asset-pill-retired .asset-pill-dot { background: #94a3b8; }

  /* Criticality variants */
  .asset-pill-criticality {
    background: rgba(148,163,184,0.12);
    color: #cbd5e1;
    border: 1px solid rgba(148,163,184,0.2);
  }
  .asset-pill-critical {
    background: rgba(239,68,68,0.12);
    color: #fca5a5;
    border-color: rgba(239,68,68,0.25);
  }
  .asset-pill-high {
    background: rgba(249,115,22,0.12);
    color: #fdba74;
    border-color: rgba(249,115,22,0.25);
  }
  .asset-pill-medium {
    background: rgba(251,191,36,0.12);
    color: #fde68a;
    border-color: rgba(251,191,36,0.25);
  }
  .asset-pill-low {
    background: rgba(34,197,94,0.12);
    color: #86efac;
    border-color: rgba(34,197,94,0.25);
  }
  .asset-pill-category {
    background: rgba(99,102,241,0.12);
    color: #a5b4fc;
    border: 1px solid rgba(99,102,241,0.2);
  }

  /* ─── Action Buttons ─── */
  .asset-hero-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-shrink: 0;
  }
  .asset-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .asset-action-primary {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    box-shadow: 0 2px 8px rgba(99,102,241,0.3);
  }
  .asset-action-primary:hover {
    box-shadow: 0 4px 16px rgba(99,102,241,0.45);
    transform: translateY(-1px);
  }
  .asset-action-ghost {
    background: rgba(255,255,255,0.08);
    color: #e2e8f0;
    border: 1px solid rgba(255,255,255,0.15);
    backdrop-filter: blur(4px);
  }
  .asset-action-ghost:hover {
    background: rgba(255,255,255,0.14);
    border-color: rgba(255,255,255,0.25);
    color: white;
  }

  @media (max-width: 768px) {
    .asset-hero-content {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }
    .asset-hero-left { flex-direction: column; align-items: flex-start; }
    .asset-hero-actions { width: 100%; }
    .asset-action-btn { flex: 1; justify-content: center; }
  }

  /* ─── Existing: Status badges (for rest of page) ─── */
  .status-operational { background: #dcfce7; color: #166534; }
  .status-under_maintenance { background: #fef3c7; color: #b45309; }
  .status-out_of_service { background: #fee2e2; color: #b91c1c; }
  .status-retired { background: #f1f5f9; color: #64748b; }
  
  /* ─── Timeline ─── */
  .timeline {
    position: relative;
    padding-left: 1.5rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e2e8f0;
  }
  .timeline-item {
    position: relative;
    padding-bottom: 1rem;
  }
  .timeline-dot {
    position: absolute;
    left: -1.15rem;
    top: 0.25rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #6366f1;
    border: 2px solid white;
  }
  .timeline-date {
    font-size: 0.75rem;
    color: #64748b;
    display: block;
    margin-bottom: 0.25rem;
  }
  .timeline-content strong {
    font-size: 0.875rem;
    color: #1e293b;
    display: block;
  }

  /* ─── Quick Actions ─── */
  .quick-actions {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
