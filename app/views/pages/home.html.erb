<%= content_for :title, "Kadibs - Engineering Services" %>

<div class="landing-page">
  <!-- Navigation Header -->
  <%= render "shared/public_header" %>


  <!-- Hero Section -->
  <header class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-badge">Kadibs Engineering Services Limited</span>
      <h1 class="hero-title">
        Enterprise-Grade <br/>
        <span class="gradient-text">Engineering Services</span>
      </h1>
      <p class="hero-subtitle">
        Delivering excellence in Engineering Designs, Construction, Operations, 
        Maintenance, NDT Services, and heavy-duty rental equipment across industries.
      </p>
      <div class="hero-actions">
        <%= link_to "Our Services", services_path, class: "btn btn-primary btn-lg" %>
        <%= link_to "Contact Us", contact_path, class: "btn btn-white btn-lg" %>
      </div>
    </div>
  </header>

  <!-- Core Services Overview -->
  <section class="services-overview">
    <div class="section-header">
      <h2 class="section-title">Our Core Capabilities</h2>
      <p class="section-subtitle">Comprehensive solutions tailored to meet your industrial and engineering demands.</p>
    </div>
    
    <div class="services-grid">
      <div class="service-card">
        <div class="service-image" style="background-image: url('<%= image_path('design.jpg') %>');"></div>
        <div class="service-content">
          <h3>Designs & Consultancy</h3>
          <p>Expert consulting, corrosion control, gritblasting, coating, and cathodic protection.</p>
          <%= link_to "Learn more →", services_path, class: "service-link" %>
        </div>
      </div>
      
      <div class="service-card">
        <div class="service-image" style="background-image: url('<%= image_path('construction.jpg') %>');"></div>
        <div class="service-content">
          <h3>Construction & Maintenance</h3>
          <p>Design, construction, and maintenance of steel structures and storage tanks.</p>
          <%= link_to "Learn more →", services_path, class: "service-link" %>
        </div>
      </div>
      
      <div class="service-card">
        <div class="service-image" style="background-image: url('<%= image_path('operations.png') %>');"></div>
        <div class="service-content">
          <h3>Operations & Facilities</h3>
          <p>End-to-end operations and maintenance of plants and industrial facilities.</p>
          <%= link_to "Learn more →", services_path, class: "service-link" %>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us / CTA -->
  <section class="cta-section" style="background-image: linear-gradient(rgba(29,53,87,0.9), rgba(29,53,87,0.9)), url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=1600&q=80');">
    <div class="cta-content">
      <h2>Transforming Infrastructure with Precision</h2>
      <p>Partner with Kadibs Engineering Services Limited for reliable, innovative, and world-class engineering execution.</p>
      <%= link_to "Get in Touch Today", contact_path, class: "btn btn-white btn-lg" %>
    </div>
  </section>

  <%= render "shared/footer" %>
</div>

<style>
  .landing-page {
    background-color: var(--light);
    color: var(--dark);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    min-height: 100vh;
  }
  
  /* Buttons */
  .btn-accent {
    background: var(--accent);
    color: var(--white);
  }
  
  .btn-accent:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }

  .btn-white {
    background: var(--white);
    color: var(--dark);
  }

  .btn-white:hover {
    background: var(--gray-200);
    transform: translateY(-2px);
  }
  
  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1.1rem;
  }
  
  /* Hero Section */
  .hero {
    position: relative;
    padding: 8rem 2rem;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1600&q=80');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg, rgba(17, 24, 39, 0.9) 0%, rgba(23, 113, 209, 0.8) 100%);
    z-index: 1;
  }
  
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    color: var(--white);
  }
  
  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(4px);
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  
  .gradient-text {
    color: var(--accent);
  }
  
  .hero-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 750px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }
  
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  
  /* Services Overview */
  .services-overview {
    padding: 6rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 1rem;
  }
  
  .section-subtitle {
    color: var(--dark-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  
  .service-card {
    background: var(--white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }
  
  .service-image {
    height: 220px;
    background-size: cover;
    background-position: center;
  }
  
  .service-content {
    padding: 2rem;
  }
  
  .service-content h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--dark);
  }
  
  .service-content p {
    color: var(--dark-muted);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  
  .service-link {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .service-link:hover {
    color: var(--primary-dark);
  }
  
  /* CTA Section */
  .cta-section {
    padding: 6rem 2rem;
    text-align: center;
    color: var(--white);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }
  
  .cta-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-section h2 {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
  }
  
  .cta-section p {
    font-size: 1.2rem;
    margin-bottom: 2.5rem;
    opacity: 0.9;
  }
  
  /* Footer */
  .footer {
    background: var(--dark);
    color: var(--gray-200);
    padding: 5rem 2rem 2rem;
  }
  
  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }
  
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  
  .footer-logo .logo-text {
    color: var(--white);
  }
  
  .brand-desc {
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--white);
  }

  .md-info {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .md-info strong {
    color: var(--white);
    font-size: 1.1rem;
  }
  
  .md-info span {
    font-size: 0.9rem;
    color: var(--accent);
  }

  .footer-links-col h4, .footer-contact-col h4 {
    color: var(--white);
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
  }
  
  .footer-links-col a {
    display: block;
    color: var(--gray-200);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 0.2s;
  }
  
  .footer-links-col a:hover {
    color: var(--accent);
  }
  
  .footer-contact-col p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .footer-contact-col strong {
    color: var(--white);
  }
  
  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    font-size: 0.9rem;
    color: rgba(255,255,255,0.5);
  }
  
  @media (max-width: 992px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-actions {
      flex-direction: column;
    }
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
