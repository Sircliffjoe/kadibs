<%= content_for :title, "About Us - Kadibs Engineering" %>

<div class="landing-page inner-page">
  <!-- Navigation Header -->
  <%= render "shared/public_header" %>


  <!-- Page Header -->
  <header class="page-header" style="background-image: linear-gradient(rgba(17,24,39,0.85), rgba(29,53,87,0.85)), url('https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=1600&q=80');">
    <div class="header-content">
      <h1>About KADIBS ENGINEERING</h1>
      <p>Building a legacy of excellence in specialized engineering services across Nigeria and beyond.</p>
    </div>
  </header>

  <!-- About Content -->
  <section class="about-content-section">
    <div class="about-container">
      <div class="about-text">
        <h2>Who We Are</h2>
        <p><strong>KADIBS ENGINEERING SERVICES LIMITED</strong> is a premier engineering firm dedicated to delivering world-class solutions in design, construction, structural maintenance, and non-destructive testing.</p>
        <p>Led by our Managing Director, <strong>Engr. Dr. Goodluck Ikenyiri</strong>, we have built a reputation for uncompromised quality, strict safety standards, and innovative approaches to complex industrial challenges.</p>
        
        <div class="mission-vision">
          <div class="mv-box">
            <div class="mv-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Our Mission</h3>
            <p>To provide reliable, safe, and cost-effective engineering solutions that ensure the operational integrity of our clients' assets.</p>
          </div>
          <div class="mv-box">
            <div class="mv-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
            </div>
            <h3>Our Vision</h3>
            <p>To be the leading indigenous engineering services provider, recognized globally for technical excellence and innovation.</p>
          </div>
        </div>
      </div>
      
      <div class="about-image">
        <img src="https://images.unsplash.com/photo-1531834685032-c34bf0d84c77?w=800&q=80" alt="Engineering Team" />
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-section">
    <div class="stats-container">
      <div class="stat-item">
        <div class="stat-number">15+</div>
        <div class="stat-label">Years of Experience</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">200+</div>
        <div class="stat-label">Projects Completed</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">50+</div>
        <div class="stat-label">Expert Engineers</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">100%</div>
        <div class="stat-label">Safety Compliance</div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section" style="background-image: linear-gradient(rgba(29,53,87,0.9), rgba(29,53,87,0.9)), url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=1600&q=80');">
    <div class="cta-content">
      <h2>Partner with Industry Experts</h2>
      <p>Reach out today to discuss how our engineering capabilites can support your next major project.</p>
      <%= link_to "Contact Us Today", contact_path, class: "btn btn-white btn-lg" %>
    </div>
  </section>

  <%= render "shared/footer" %>
</div>

<style>
  .landing-page {
    background-color: var(--light);
    color: var(--dark);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    min-height: 100vh;
  }
  
  /* Page Header */
  .page-header {
    padding: 6rem 2rem;
    text-align: center;
    color: var(--white);
    background-size: cover;
    background-position: center;
  }
  
  .header-content h1 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .btn-white {
    background: white !important;
    color: var(--dark);
  }
  
  .btn-white:hover {
    background: var(--gray-200);
    transform: translateY(-2px);
  }
  
  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1.1rem;
  }
  
  .header-content p {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.9);
  }
  
  /* About Content */
  .about-content-section {
    padding: 6rem 2rem;
    background: white;
  }
  
  .about-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .about-text h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    color: var(--primary);
  }
  
  .about-text p {
    font-size: 1.1rem;
    color: var(--dark-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  
  .mission-vision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }
  
  .mv-icon {
    width: 60px;
    height: 60px;
    background: rgba(29, 53, 87, 0.1);
    color: var(--primary);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  
  .mv-icon svg {
    width: 30px;
    height: 30px;
  }
  
  .mv-box h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--primary);
  }
  
  .mv-box p {
    color: var(--dark-muted);
    line-height: 1.6;
  }
  
  .about-image img {
    width: 100%;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  
  /* Stats Section */
  .stats-section {
    padding: 6rem 2rem;
    background: var(--primary);
    color: white;
  }
  
  .stats-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem;
  }
  
  .stat-item {
    text-align: center;
  }
  
  .stat-number {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }
  
  .stat-label {
    font-size: 1rem;
    font-weight: 500;
    opacity: 0.9;
  }
  
  /* CTA Section */
  .cta-section {
    padding: 8rem 2rem;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    text-align: center;
    color: white;
  }
  
  .cta-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .cta-content h2 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
  }
  
  .cta-content p {
    font-size: 1.4rem;
    margin-bottom: 3rem;
    opacity: 0.9;
  }
  
  @media (max-width: 768px) {
    .page-header h1 { font-size: 2.5rem; }
    .about-container { grid-template-columns: 1fr; }
    .about-image { order: -1; }
    .cta-content h2 { font-size: 2.2rem; }
    .mission-vision { grid-template-columns: 1fr; }
  }
</style>
