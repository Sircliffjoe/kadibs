<%= content_for :title, "Services - Kadibs Engineering" %>

<div class="landing-page inner-page">
  <!-- Navigation Header -->
  <%= render "shared/public_header" %>

  <!-- Page Header -->
  <header class="page-header" style="background-image: linear-gradient(rgba(17,24,39,0.85), rgba(29,53,87,0.85)), url('https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=1600&q=80');">
    <div class="header-content">
      <h1>Our Specialized Services</h1>
      <p>Delivering high-precision engineering solutions through expertise, innovation, and cutting-edge technology.</p>
    </div>
  </header>

  <!-- Services Grid -->
  <section class="services-detail-section">
    <div class="services-container">
      <!-- Service 1 -->
      <div class="service-detail-card">
        <div class="sd-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <div class="sd-content">
          <h3>Designs & Consultancy</h3>
          <p>We provide comprehensive engineering designs and expert consultancy services including Corrosion Control, Gritblasting, Coating, and Cathodic Protection systems.</p>
          <ul>
            <li>Front-End Engineering Design (FEED)</li>
            <li>Detailed Engineering Design</li>
            <li>Corrosion Management Strategies</li>
            <li>Protective Coating Specifications</li>
          </ul>
        </div>
      </div>

      <!-- Service 2 -->
      <div class="service-detail-card">
        <div class="sd-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="sd-content">
          <h3>Construction & Structural Maintenance</h3>
          <p>Expert fabrication, installation, and maintenance of critical infrastructure, steel structures, and storage facilities.</p>
          <ul>
            <li>Steel Structure Fabrication</li>
            <li>Storage Tank Construction & Repair</li>
            <li>Pipeline Installation</li>
            <li>Structural Integrity Assessment</li>
          </ul>
        </div>
      </div>

      <!-- Service 3 -->
      <div class="service-detail-card">
        <div class="sd-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <div class="sd-content">
          <h3>Operations & Facilities Management</h3>
          <p>Seamless management and maintenance of industrial plants and facilities to ensure maximum uptime and safety.</p>
          <ul>
            <li>Plant Turnaround Maintenance</li>
            <li>Facility Integrity Management</li>
            <li>Technical Manpower Supply</li>
            <li>Preventive Maintenance Systems</li>
          </ul>
        </div>
      </div>

      <!-- Service 4 -->
      <div class="service-detail-card">
        <div class="sd-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="sd-content">
          <h3>Non-Destructive Testing (NDT)</h3>
          <p>Advanced NDT services using state-of-the-art equipment to identify defects without damaging the asset.</p>
          <ul>
            <li>Ultrasonic Testing (UT)</li>
            <li>Radiographic Testing (RT)</li>
            <li>Magnetic Particle Inspection (MPI)</li>
            <li>Dye Penetrant Inspection (DPI)</li>
          </ul>
        </div>
      </div>

      <!-- Service 5 -->
      <div class="service-detail-card">
        <div class="sd-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </div>
        <div class="sd-content">
          <h3>Procurement & Rental Services</h3>
          <p>Supply of specialized engineering materials and rental of heavy-duty equipment for complex projects.</p>
          <ul>
            <li>Heavy-Duty Crane Rentals</li>
            <li>Earthmoving Equipment</li>
            <li>Specialized Tool Procurement</li>
            <li>Subsea Equipment Supply</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section" style="background-image: linear-gradient(rgba(29,53,87,0.9), rgba(29,53,87,0.9)), url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=1600&q=80');">
    <div class="cta-content">
      <h2>Reliable Execution, Every Time</h2>
      <p>Contact us today for a detailed technical proposal for your engineering needs.</p>
      <%= link_to "Request a Quote", contact_path, class: "btn btn-white btn-lg" %>
    </div>
  </section>

  <%= render "shared/footer" %>
</div>

<style>
  .landing-page {
    background-color: var(--light);
    color: var(--dark);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    min-height: 100vh;
  }
  
  /* Page Header */
  .page-header {
    padding: 6rem 2rem;
    text-align: center;
    color: var(--white);
    background-size: cover;
    background-position: center;
  }
  
  .header-content h1 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .btn-white {
    background: white !important;
    color: var(--dark);
  }
  
  .btn-white:hover {
    background: var(--gray-200);
    transform: translateY(-2px);
  }
  
  .header-content p {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.9);
  }
  
  /* Services Section */
  .services-detail-section {
    padding: 6rem 2rem;
    background: white;
  }
  
  .services-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  
  .service-detail-card {
    display: flex;
    gap: 3rem;
    padding: 3rem;
    background: var(--light);
    border-radius: 20px;
    border: 1px solid var(--gray-200);
    transition: transform 0.3s ease;
  }
  
  .service-detail-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(29, 53, 87, 0.08);
  }
  
  .sd-icon {
    width: 64px;
    height: 64px;
    background: var(--primary);
    color: white;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .sd-icon svg {
    width: 32px;
    height: 32px;
  }
  
  .sd-content h3 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--primary);
  }
  
  .sd-content p {
    font-size: 1.1rem;
    color: var(--dark-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  
  .sd-content ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
  
  .sd-content li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--dark-muted);
    font-weight: 500;
  }
  
  .sd-content li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 800;
  }
  
  /* CTA Section */
  .cta-section {
    padding: 8rem 2rem;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    text-align: center;
    color: white;
  }
  
  .cta-content h2 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
  }
  
  .cta-content p {
    font-size: 1.4rem;
    margin-bottom: 3rem;
    opacity: 0.9;
  }
  
  @media (max-width: 768px) {
    .page-header h1 { font-size: 2.5rem; }
    .service-detail-card { flex-direction: column; padding: 2rem; gap: 1.5rem; }
    .sd-content h3 { font-size: 1.5rem; }
    .sd-content ul { grid-template-columns: 1fr; }
    .cta-content h2 { font-size: 2.2rem; }
  }
</style>
