<div class="nested-form-wrapper form-card" style="background: #f8fafc; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #e2e8f0;" data-new-record="<%= f.object&.new_record? %>">
  <div class="form-row">
    <div class="form-group" style="flex: 2;">
      <%= f.label :part_id, class: "form-label" %>
      <%= f.collection_select :part_id, Part.order(:name), :id, :name, { prompt: "Select Part" }, class: "form-select" %>
    </div>
    <div class="form-group">
      <%= f.label :quantity_requested, "Qty", class: "form-label" %>
      <%= f.number_field :quantity_requested, min: 1, step: 1, class: "form-input" %>
    </div>
    <div class="form-group">
      <%= f.label :unit_price, "Est. Cost", class: "form-label" %>
      <%= f.number_field :unit_price, step: "0.01", class: "form-input" %>
    </div>
  </div>
  
  <div class="form-row">
    <div class="form-group" style="flex: 1;">
      <%= f.label :notes, class: "form-label" %>
      <%= f.text_field :notes, class: "form-input", placeholder: "Item specific notes" %>
    </div>
    <div class="form-group" style="display: flex; align-items: flex-end;">
      <%= f.hidden_field :_destroy %>
      <button type="button" class="btn btn-danger-outline btn-sm" data-action="nested-form#remove" style="width: 100%;">
        Remove Item
      </button>
    </div>
  </div>
</div>
