<div class="nested-form-wrapper form-card" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:1.25rem; margin-bottom:1.25rem;" data-new-record="<%= f.object&.new_record? %>">
  <div class="form-row" style="gap: 1rem; align-items: flex-start;">
    <div class="form-group" style="flex: 2;">
      <%= f.label :part_id, "Select Part", class: "form-label" %>
      <%= f.collection_select :part_id, Part.order(:name), :id, :name, { prompt: "Search or select part..." }, class: "form-select" %>
    </div>
    <div class="form-group" style="width: 120px; flex: none;">
      <%= f.label :quantity_requested, "Qty", class: "form-label" %>
      <%= f.number_field :quantity_requested, min: 1, step: 1, class: "form-input", placeholder: "1" %>
    </div>
    <div class="form-group" style="width: 140px; flex: none;">
      <%= f.label :unit_price, "Est. Cost", class: "form-label" %>
      <%= f.number_field :unit_price, step: "0.01", class: "form-input", placeholder: "0.00" %>
    </div>
  </div>
  
  <div class="form-row" style="gap: 1rem; margin-top: 0.5rem;">
    <div class="form-group" style="flex: 1;">
      <%= f.label :notes, class: "form-label" %>
      <%= f.text_field :notes, class: "form-input", placeholder: "Specifications, brand, or other item details..." %>
    </div>
    <div class="form-group" style="display: flex; align-items: flex-end; flex: none; width: 140px;">
      <%= f.hidden_field :_destroy %>
      <button type="button" class="btn btn-danger-outline btn-sm" data-action="nested-form#remove" style="width: 100%; height: 42px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;">
          <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        </svg>
        Remove
      </button>
    </div>
  </div>
</div>
