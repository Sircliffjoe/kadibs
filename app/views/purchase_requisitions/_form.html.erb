<%= render "shared/form_styles" %>

<%= form_with(model: purchase_requisition, local: true, class: "resource-form", data: { controller: "nested-form" }) do |f| %>
  <% if purchase_requisition.errors.any? %>
    <div class="form-errors">
      <h4><%= pluralize(purchase_requisition.errors.count, "error") %> prohibited this requisition from being saved:</h4>
      <ul>
        <% purchase_requisition.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-section">
    <h3 class="form-section-title">Requisition Details</h3>
    <div class="form-row">
      <div class="form-group">
        <%= f.label :supplier_id, class: "form-label" %>
        <%= f.collection_select :supplier_id, Supplier.order(:name), :id, :name, { prompt: "Select Supplier" }, class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :required_date, "Needed By Date", class: "form-label" %>
        <%= f.date_field :required_date, class: "form-input" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group full-width">
        <%= f.label :shipping_address, class: "form-label" %>
        <%= f.text_area :shipping_address, rows: 2, class: "form-textarea" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group full-width">
        <%= f.label :notes, class: "form-label" %>
        <%= f.text_area :notes, rows: 3, class: "form-textarea" %>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <h3 class="form-section-title" style="margin: 0;">Items</h3>
      <button type="button" class="btn btn-outline btn-sm" data-action="nested-form#add">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px; margin-right: 4px;">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Add Item
      </button>
    </div>

    <div class="nested-items-container">
      <%= f.fields_for :purchase_requisition_items do |item_fields| %>
        <%= render "purchase_requisition_item_fields", f: item_fields %>
      <% end %>

      <div data-nested-form-target="target"></div>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :purchase_requisition_items, PurchaseRequisitionItem.new, child_index: "NEW_RECORD" do |item_fields| %>
        <%= render "purchase_requisition_item_fields", f: item_fields %>
      <% end %>
    </template>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", purchase_requisitions_path, class: "btn btn-outline" %>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
