<%= content_for :title, "My Profile - Kadibs" %>
<%= render "shared/form_styles" %>

<%= render "shared/account_tabs" %>

<div class="account-content">
  <div class="profile-layout">
    <!-- Profile Card -->
    <div class="profile-card">
      <div class="profile-header">
        <div class="profile-avatar-large">
          <%= @user.first_name&.first&.upcase %><%= @user.last_name&.first&.upcase %>
        </div>
        <div class="profile-identity">
          <h2><%= @user.full_name %></h2>
          <p class="profile-job"><%= @user.job_title.presence || "Team Member" %></p>
          <div class="profile-roles">
            <% @user.roles.each do |role| %>
              <span class="role-badge"><%= role.name %></span>
            <% end %>
          </div>
        </div>
        <div class="profile-actions">
          <%= link_to edit_profile_path, class: "btn btn-light" do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Edit
          <% end %>
        </div>
      </div>
      
      <div class="profile-details">
        <div class="detail-row">
          <span class="detail-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            Email
          </span>
          <span class="detail-value"><%= @user.email %></span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Phone
          </span>
          <span class="detail-value"><%= @user.phone.presence || "Not set" %></span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Organization
          </span>
          <span class="detail-value"><%= current_organization&.name %></span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Member Since
          </span>
          <span class="detail-value"><%= @user.created_at.strftime("%B %d, %Y") %></span>
        </div>
      </div>
    </div>
    
    <!-- Activity Summary -->
    <div class="profile-stats">
      <h3>Activity Summary</h3>
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-value"><%= @user.work_orders.count rescue 0 %></span>
          <span class="stat-label">Work Orders</span>
        </div>
        <div class="stat-card">
          <span class="stat-value"><%= @user.work_orders.where(status: 'completed').count rescue 0 %></span>
          <span class="stat-label">Completed</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .account-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .profile-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 1.5rem;
  }
  
  @media (max-width: 768px) {
    .profile-layout { grid-template-columns: 1fr; }
  }
  
  .profile-card {
    background: white;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    overflow: hidden;
  }
  
  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    background: linear-gradient(135deg, #0f172a 0%, #334155 100%) !important;
    color: white;
  }
  
  .profile-avatar-large {
    width: 72px;
    height: 72px;
    border-radius: 14px;
    background: rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  
  .profile-identity {
    flex: 1;
  }
  
  .profile-identity h2 {
    margin: 0;
    font-size: 1.4rem;
  }
  
  .profile-job {
    margin: 0.25rem 0 0.75rem;
    opacity: 0.9;
    font-size: 0.95rem;
  }
  
  .profile-roles {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .role-badge {
    padding: 0.25rem 0.75rem;
    background: rgba(255,255,255,0.2);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  
  .profile-actions {
    flex-shrink: 0;
  }
  
  .btn-light {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: rgba(255,255,255,0.2);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s;
  }
  
  .btn-light:hover {
    background: rgba(255,255,255,0.3);
  }
  
  .btn-light .btn-icon {
    width: 16px;
    height: 16px;
  }
  
  .profile-details {
    padding: 1.5rem 2rem;
  }
  
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid #f1f5f9;
  }
  
  .detail-row:last-child { border-bottom: none; }
  
  .detail-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #6b7280;
    font-size: 0.9rem;
  }
  
  .detail-label svg {
    width: 18px;
    height: 18px;
  }
  
  .detail-value {
    font-weight: 500;
    color: #1e293b;
  }
  
  .profile-stats {
    background: white;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    padding: 1.5rem;
    height: fit-content;
  }
  
  .profile-stats h3 {
    margin: 0 0 1rem;
    font-size: 1rem;
    color: #374151;
  }
  
  .stats-grid {
    display: grid;
    gap: 1rem;
  }
  
  .stat-card {
    background: #f8fafc;
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
  }
  
  .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
  }
  
  .stat-label {
    font-size: 0.8rem;
    color: #6b7280;
  }
</style>
