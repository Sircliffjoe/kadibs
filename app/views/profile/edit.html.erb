<%= content_for :title, "Edit Profile - Kadibs" %>
<%= render "shared/form_styles" %>

<%= render "shared/account_tabs" %>

<div class="account-content">
  <div class="form-container">
    <%= form_with model: @user, url: profile_path, method: :patch, class: "resource-form" do |f| %>
      <% if @user.errors.any? %>
        <div class="form-errors">
          <h4><%= pluralize(@user.errors.count, "error") %> prevented your profile from being saved</h4>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-section">
        <h3 class="form-section-title">Personal Information</h3>
        
        <div class="form-row">
          <div class="form-group">
            <%= f.label :first_name, class: "form-label" do %>
              First Name <span class="required">*</span>
            <% end %>
            <%= f.text_field :first_name, class: "form-input", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :last_name, class: "form-label" do %>
              Last Name <span class="required">*</span>
            <% end %>
            <%= f.text_field :last_name, class: "form-input", required: true %>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <%= f.label :job_title, class: "form-label" do %>
              Job Title
            <% end %>
            <%= f.text_field :job_title, class: "form-input", placeholder: "e.g. Maintenance Technician" %>
          </div>

          <div class="form-group">
            <%= f.label :phone, class: "form-label" do %>
              Phone Number
            <% end %>
            <%= f.telephone_field :phone, class: "form-input", placeholder: "+1 (555) 123-4567" %>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3 class="form-section-title">Email Address</h3>
        
        <div class="form-row">
          <div class="form-group full">
            <%= f.label :email, class: "form-label" do %>
              Email <span class="required">*</span>
            <% end %>
            <%= f.email_field :email, class: "form-input", required: true %>
            <span class="form-help">This is also your login email address</span>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Cancel", profile_path, class: "btn btn-outline" %>
        <%= f.submit "Save Changes", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .account-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>
