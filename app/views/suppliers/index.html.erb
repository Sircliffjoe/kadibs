<%= content_for :title, "Vendors - Kadibs" %>

<div class="page-header">
  <div class="page-header-content">
    <h1>Vendors</h1>
    <p class="page-subtitle">Manage your suppliers and vendors</p>
  </div>
  <div class="page-actions">
    <%= link_to new_supplier_path, class: "btn btn-primary" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add Vendor
    <% end %>
  </div>
</div>

<div class="filters-bar">
  <%= form_with url: suppliers_path, method: :get, class: "filters-form" do |f| %>
    <div class="filter-group">
      <%= f.text_field :search, value: params[:search], placeholder: "Search vendors...", class: "filter-input" %>
    </div>
    <%= f.submit "Search", class: "btn btn-outline" %>
    <%= link_to "Clear", suppliers_path, class: "btn btn-text" %>
  <% end %>
</div>

<div class="data-table-container">
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Contact</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Parts</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @suppliers.any? %>
        <% @suppliers.each do |supplier| %>
          <tr>
            <td><%= link_to supplier.name, supplier, class: "table-link" %></td>
            <td><%= supplier.contact_name || '—' %></td>
            <td><%= supplier.email || '—' %></td>
            <td><%= supplier.phone || '—' %></td>
            <td><%= supplier.parts.count %></td>
            <td>
              <div class="table-actions">
                <%= link_to supplier, class: "action-btn", title: "View" do %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <% end %>
                <%= link_to edit_supplier_path(supplier), class: "action-btn", title: "Edit" do %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="empty-table">
            <div class="empty-state">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="empty-icon">
                <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              </svg>
              <p>No vendors found</p>
              <%= link_to "Add your first vendor", new_supplier_path, class: "btn btn-primary" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/table_styles" %>
