<%= render "shared/form_styles" %>

<%= form_with(model: supplier, local: true, class: "resource-form") do |f| %>
  <% if supplier.errors.any? %>
    <div class="form-errors">
      <h4><%= pluralize(supplier.errors.count, "error") %> prevented saving:</h4>
      <ul>
        <% supplier.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-title">
      <h3>Company Information</h3>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <%= f.label :name, "Company Name *", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g. Acme Supplies Inc." %>
      </div>
      
      <div class="form-group">
        <%= f.label :code, "Vendor Code", class: "form-label" %>
        <%= f.text_field :code, class: "form-input", placeholder: "Optional code" %>
      </div>

      <div class="form-group">
        <%= f.label :website, class: "form-label" %>
        <%= f.url_field :website, class: "form-input", placeholder: "https://example.com" %>
      </div>
      
      <div class="form-group">
        <%= f.label :tax_id, "Tax ID / VAT", class: "form-label" %>
        <%= f.text_field :tax_id, class: "form-input" %>
      </div>

      <div class="form-group full">
        <%= f.label :notes, class: "form-label" %>
        <%= f.text_area :notes, class: "form-input", rows: 3 %>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">
      <h3>Contact Information</h3>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <%= f.label :contact_name, "Contact Person", class: "form-label" %>
        <%= f.text_field :contact_name, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :contact_title, "Job Title", class: "form-label" %>
        <%= f.text_field :contact_title, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :phone, class: "form-label" %>
        <%= f.telephone_field :phone, class: "form-input" %>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">
      <h3>Address</h3>
    </div>
    
    <div class="form-row">
      <div class="form-group full">
        <%= f.label :street, "Street Address", class: "form-label" %>
        <%= f.text_field :street, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :city, class: "form-label" %>
        <%= f.text_field :city, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :state, "State/Province", class: "form-label" %>
        <%= f.text_field :state, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :postal_code, "ZIP/Postal Code", class: "form-label" %>
        <%= f.text_field :postal_code, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :country, class: "form-label" %>
        <%= f.text_field :country, class: "form-input" %>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header">
      <h3>Settings</h3>
    </div>
    <div class="form-grid">
      <div class="form-group">
        <label class="checkbox-label">
          <%= f.check_box :active, class: "form-checkbox" %>
          <span>Active Vendor</span>
        </label>
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <%= f.check_box :preferred, class: "form-checkbox" %>
          <span>Preferred Supplier</span>
        </label>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", suppliers_path, class: "btn btn-outline" %>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
