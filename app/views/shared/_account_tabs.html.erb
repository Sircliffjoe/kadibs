<div class="account-header">
  <div class="account-header-content">
    <h1>Account Settings</h1>
    <p class="page-subtitle">Manage your account preferences and security</p>
  </div>
  
  <nav class="account-tabs">
    <%= link_to profile_path, class: "account-tab #{'active' if controller_name == 'profile'}" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      Profile
    <% end %>
    
    <%= link_to settings_path, class: "account-tab #{'active' if controller_name == 'settings'}" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m7.08 7.08l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m7.08-7.08l4.24-4.24"/>
      </svg>
      Settings
    <% end %>
    
    <%= link_to settings_path(anchor: "notifications"), class: "account-tab" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      Notifications
    <% end %>
    
    <%= link_to organization_path, class: "account-tab #{'active' if controller_name == 'organizations'}" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      Organization
    <% end %>
  </nav>
</div>

<style>
  .account-header {
    max-width: 900px;
    margin: 0 auto 2rem;
    padding: 0 1.5rem;
  }
  
  .account-header-content {
    margin-bottom: 1.5rem;
  }
  
  .account-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }
  
  .page-subtitle {
    color: #64748b;
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
  }
  
  .account-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0;
  }
  
  .account-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    color: #6b7280;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all 0.15s ease;
  }
  
  .account-tab:hover {
    color: var(--primary);
    background: #f0f7ff;
    border-radius: 8px 8px 0 0;
  }
  
  .account-tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }
  
  .account-tab svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  
  @media (max-width: 640px) {
    .account-tabs {
      flex-wrap: wrap;
      gap: 0.25rem;
    }
    
    .account-tab {
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
    }
  }
</style>
