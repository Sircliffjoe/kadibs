<%# Standard Error Partial %>
<% if resource.errors.any? %>
  <div class="form-errors">
    <h4><%= pluralize(resource.errors.count, "error") %> prevented this record from being saved:</h4>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
