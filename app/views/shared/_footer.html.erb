<style>
  .footer {
    background: var(--dark);
    color: var(--gray-200);
    padding: 5rem 2rem 2rem;
  }
  
  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }
  
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  
  .footer-logo .logo-text {
    color: var(--white);
    font-weight: 800;
  }
  
  .brand-desc {
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--white);
  }

  .md-info {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .md-info strong {
    color: var(--white);
    font-size: 1.1rem;
  }
  
  .md-info span {
    color: var(--accent);
    font-size: 0.9rem;
  }
  
  .footer-links-col h4, .footer-contact-col h4 {
    color: var(--white);
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
  }
  
  .footer-links-col a {
    display: block;
    color: var(--gray-200);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 0.2s;
  }
  
  .footer-links-col a:hover {
    color: var(--accent);
  }
  
  .footer-contact-col p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .footer-contact-col strong {
    color: var(--white);
  }
  
  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    font-size: 0.9rem;
    color: rgba(255,255,255,0.5);
  }

  @media (max-width: 992px) {
    .footer-container { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .footer-container { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
