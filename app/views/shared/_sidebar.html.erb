<%# Sidebar Navigation %>
<aside class="sidebar" data-sidebar-target="sidebar">
  <!-- Logo -->
  <div class="sidebar-header">
    <div class="sidebar-logo">
      <span style="font-size: 1.25rem; font-weight: 800; color: white;">β</span>
    </div>
    <span class="sidebar-brand">KADIBS</span>
    
    <!-- Mobile Close Button -->
    <button class="mobile-close-btn" data-action="click->sidebar#closeMobile">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Navigation -->
  <nav class="sidebar-nav">
    <!-- Main Menu -->
    <div class="nav-section">
      <div class="nav-section-title">Main</div>

      <%= link_to dashboard_path, class: "nav-item #{controller_name == 'dashboard' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        <span class="nav-label">Dashboard</span>
      <% end %>

      <%= link_to assets_path, class: "nav-item #{controller_name == 'assets' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h4"/>
        </svg>
        <span class="nav-label">Equipment</span>
      <% end %>

      <%= link_to work_orders_path, class: "nav-item #{controller_name == 'work_orders' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        <span class="nav-label">Work Orders</span>
      <% end %>

      <%= link_to pm_schedules_path, class: "nav-item #{controller_name == 'pm_schedules' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span class="nav-label">Preventive Maintenance</span>
      <% end %>

      <%= link_to inspections_path, class: "nav-item #{controller_name == 'inspections' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
        </svg>
        <span class="nav-label">Inspections</span>
      <% end %>
    </div>

    <!-- Inventory Section -->
    <div class="nav-section">
      <div class="nav-section-title">Inventory</div>

      <%= link_to parts_path, class: "nav-item #{controller_name == 'parts' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        </svg>
        <span class="nav-label">Parts & Inventory</span>
      <% end %>

      <%= link_to warehouses_path, class: "nav-item #{controller_name == 'warehouses' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        </svg>
        <span class="nav-label">Warehouses</span>
      <% end %>

      <%= link_to purchase_requisitions_path, class: "nav-item #{controller_name == 'purchase_requisitions' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="nav-label">Purchase Orders</span>
      <% end %>
    </div>

    <!-- Organization Section -->
    <div class="nav-section">
      <div class="nav-section-title">Organization</div>

      <%= link_to locations_path, class: "nav-item #{controller_name == 'locations' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span class="nav-label">Locations</span>
      <% end %>

      <%= link_to users_path, class: "nav-item #{controller_name == 'users' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span class="nav-label">Employees</span>
      <% end %>

      <%= link_to suppliers_path, class: "nav-item #{controller_name == 'suppliers' ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
          <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <span class="nav-label">Vendors</span>
      <% end %>
    </div>

    <!-- Analytics Section -->
    <div class="nav-section">
      <div class="nav-section-title">Analytics</div>

      <%= link_to reports_dashboard_path, class: "nav-item #{controller_path.start_with?('reports') ? 'active' : ''}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        <span class="nav-label">Reports</span>
      <% end %>
    </div>
  </nav>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer">
    <button class="sidebar-collapse-btn" data-action="click->sidebar#toggle">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      <span class="nav-label">Collapse</span>
    </button>
  </div>
</aside>