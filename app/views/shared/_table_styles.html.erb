<style>
  /* Page Header */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }
  
  .page-subtitle {
    color: #64748b;
    margin: 0.25rem 0 0;
  }
  
  .page-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    border: none;
  }
  
  .btn-icon {
    width: 16px;
    height: 16px;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
  }
  
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
  }
  
  .btn-outline {
    background: white;
    border: 1px solid #e2e8f0;
    color: #475569;
  }
  
  .btn-outline:hover {
    border-color: #6366f1;
    color: #6366f1;
  }
  
  .btn-text {
    background: transparent;
    color: #64748b;
    padding: 0.5rem;
  }
  
  .btn-text:hover {
    color: #1e293b;
  }
  
  .btn-success {
    background: #10b981;
    color: white;
  }
  
  .btn-warning {
    background: #f59e0b;
    color: white;
  }
  
  .btn-danger {
    background: #ef4444;
    color: white;
  }
  
  .btn-secondary {
    background: #64748b;
    color: white;
  }
  
  .btn-sm {
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
  }
  
  .btn-block {
    width: 100%;
    justify-content: center;
  }

  /* Filters */
  .filters-bar {
    background: white;
    padding: 1rem;
    border-radius: 12px;
    margin-bottom: 1rem;
    border: 1px solid #e2e8f0;
  }
  
  .filters-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  
  .filter-group {
    flex: 1;
    min-width: 150px;
    max-width: 250px;
  }
  
  .filter-input, .filter-select {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 0.875rem;
    background: #f8fafc;
  }
  
  .filter-input:focus, .filter-select:focus {
    outline: none;
    border-color: #6366f1;
    background: white;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: #f1f5f9;
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    border: 1px solid transparent;
  }

  .filter-chip:hover {
    background: #e2e8f0;
    color: #1e293b;
  }

  .filter-chip.active {
    background: #e0e7ff;
    color: #4338ca;
    border-color: #c7d2fe;
    font-weight: 600;
  }

  /* Page Layout */
  .page-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }


  /* Stats Row */
  .stats-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  
  .stat-pill {
    background: white;
    padding: 0.75rem 1.25rem;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid #e2e8f0;
  }
  
  .stat-pill-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: #6366f1;
  }
  
  .stat-pill-label {
    font-size: 0.8rem;
    color: #64748b;
  }
  
  .stat-pill.stat-warning .stat-pill-value { color: #f59e0b; }
  .stat-pill.stat-danger .stat-pill-value { color: #ef4444; }

  /* Data Table */
  .data-table-container {
    background: white;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
  }
  
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .data-table th {
    padding: 0.875rem 1rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }
  
  .data-table td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    font-size: 0.875rem;
    color: #334155;
  }
  
  .data-table tr:hover {
    background: #f8fafc;
  }
  
  .data-table tr.overdue {
    background: #fef2f2;
  }
  
  .table-link {
    color: #1e293b;
    font-weight: 500;
    text-decoration: none;
  }
  
  .table-link:hover {
    color: #6366f1;
  }
  
  .secondary-link {
    color: #64748b;
    text-decoration: none;
    font-size: 0.8rem;
  }
  
  .secondary-link:hover {
    color: #6366f1;
  }

  /* Status & Priority Badges */
  .status-badge, .priority-badge, .type-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  
  .status-badge { background: #f1f5f9; color: #64748b; }
  .status-open { background: #dbeafe; color: #1d4ed8; }
  .status-assigned { background: #e0e7ff; color: #4338ca; }
  .status-in_progress { background: #fef3c7; color: #b45309; }
  .status-on_hold { background: #fee2e2; color: #b91c1c; }
  .status-completed { background: #dcfce7; color: #166534; }
  .status-closed { background: #f1f5f9; color: #475569; }
  
  .priority-low { background: #f1f5f9; color: #64748b; }
  .priority-medium { background: #dbeafe; color: #1d4ed8; }
  .priority-high { background: #fef3c7; color: #b45309; }
  .priority-critical { background: #fee2e2; color: #b91c1c; }
  
  .type-badge {
    background: #e0e7ff;
    color: #4338ca;
    margin-left: 0.5rem;
  }

  /* User Cells */
  .user-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .user-avatar-small {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    font-size: 0.65rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Table Actions */
  .table-actions {
    display: flex;
    gap: 0.25rem;
  }
  
  .action-btn {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    transition: all 0.15s;
  }
  
  .action-btn:hover {
    background: #f1f5f9;
    color: #6366f1;
  }
  
  .action-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Empty State */
  .empty-table { text-align: center; }
  
  .empty-state {
    padding: 3rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  
  .empty-icon {
    width: 48px;
    height: 48px;
    color: #cbd5e1;
  }
  
  .empty-state p {
    color: #64748b;
    margin: 0;
  }

  /* Text utilities */
  .text-muted { color: #94a3b8; }
  .text-danger { color: #ef4444; }
  .font-mono { font-family: ui-monospace, monospace; }

  /* Pagination */
  .pagination-container {
    padding: 1rem;
    display: flex;
    justify-content: center;
  }
  
  .pagination { display: flex; gap: 0.25rem; list-style: none; padding: 0; margin: 0; }
  .pagination a, .pagination span { padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.875rem; }
  .pagination a { color: #64748b; text-decoration: none; }
  .pagination a:hover { background: #f1f5f9; }
  .pagination .active a { background: #6366f1; color: white; }
</style>
