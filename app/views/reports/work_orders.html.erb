<%= content_for :title, "Work Order Analysis - Kadibs" %>

<!-- Breadcrumb -->
<div class="rpt-breadcrumb">
  <%= link_to "Reports", reports_dashboard_path, class: "rpt-breadcrumb-link" %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;color:#94a3b8;"><polyline points="9 18 15 12 9 6"/></svg>
  <span class="rpt-breadcrumb-current">Work Orders</span>
</div>

<!-- Header -->
<div class="rpt-hero">
  <div class="rpt-hero-bg"></div>
  <div class="rpt-hero-content">
    <div class="rpt-hero-left">
      <div class="rpt-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </div>
      <div>
        <h1 class="rpt-hero-title">Work Order Analysis</h1>
        <p class="rpt-hero-sub"><%= @pagy.count %> total work orders</p>
      </div>
    </div>
    <div>
      <%= button_to reports_export_path(format: :csv, report: 'work_orders'), method: :post, class: "rpt-action-btn" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export CSV
      <% end %>
    </div>
  </div>
</div>

<!-- KPI Summary Cards -->
<div class="rpt-kpi-grid">
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#eef2ff;color:var(--primary);">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value"><%= @pagy.count %></span>
      <span class="rpt-kpi-label">Total Orders</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#dcfce7;color:#16a34a;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#16a34a;"><%= @status_counts["completed"] || 0 %></span>
      <span class="rpt-kpi-label">Completed</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#dbeafe;color:#2563eb;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#2563eb;"><%= @status_counts["open"] || 0 %></span>
      <span class="rpt-kpi-label">Open</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#fee2e2;color:#dc2626;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#dc2626;"><%= (@priority_counts["high"] || 0) + (@priority_counts["critical"] || 0) %></span>
      <span class="rpt-kpi-label">High / Critical</span>
    </div>
  </div>
</div>

<!-- Charts Row -->
<div class="rpt-charts-row">
  <div class="rpt-card">
    <div class="rpt-card-header">
      <h3>Status Distribution</h3>
    </div>
    <div class="rpt-card-body" style="display:flex;justify-content:center;padding:1.5rem;">
      <canvas id="statusChart" style="max-height:280px;"></canvas>
    </div>
  </div>
  <div class="rpt-card">
    <div class="rpt-card-header">
      <h3>Priority Breakdown</h3>
    </div>
    <div class="rpt-card-body" style="display:flex;justify-content:center;padding:1.5rem;">
      <canvas id="priorityChart" style="max-height:280px;"></canvas>
    </div>
  </div>
</div>

<!-- Work Orders Table -->
<div class="rpt-card" style="margin-top:1.5rem;">
  <div class="rpt-card-header">
    <h3>Work Order Details</h3>
    <span class="rpt-badge"><%= @pagy.count %> records</span>
  </div>
  <div class="rpt-table-wrap">
    <table class="rpt-table">
      <thead>
        <tr>
          <th>WO #</th>
          <th>Title</th>
          <th>Priority</th>
          <th>Status</th>
          <th>Asset</th>
          <th>Assigned To</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if @work_orders.any? %>
          <% @work_orders.each do |wo| %>
            <tr>
              <td><%= link_to wo.id, wo, class: "rpt-link rpt-mono" %></td>
              <td><%= link_to wo.title, wo, class: "rpt-link" %></td>
              <td>
                <% pclass = case wo.priority; when 'critical' then 'rpt-p-critical'; when 'high' then 'rpt-p-high'; when 'medium' then 'rpt-p-medium'; else 'rpt-p-low'; end %>
                <span class="rpt-pill <%= pclass %>"><%= wo.priority.titleize %></span>
              </td>
              <td><span class="rpt-pill rpt-s-<%= wo.status.gsub('_', '-') %>"><%= wo.status.titleize %></span></td>
              <td><%= wo.asset&.name || "—" %></td>
              <td><%= wo.assigned_to&.full_name || "Unassigned" %></td>
              <td class="rpt-muted"><%= wo.created_at.strftime("%b %d, %Y") %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="7" class="rpt-empty-cell">No work orders found</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div style="margin-top:1rem;"><%== pagy_nav(@pagy) %></div>
<% end %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Status Doughnut Chart
    var statusData = <%= raw @status_counts.to_json %>;
    var statusLabels = Object.keys(statusData).map(function(s) { return s.replace(/_/g, ' ').replace(/\b\w/g, function(l) { return l.toUpperCase(); }); });
    var statusValues = Object.values(statusData);
    var statusColors = Object.keys(statusData).map(function(s) {
      var c = { open: '#3b82f6', in_progress: '#f59e0b', completed: '#10b981', on_hold: '#6b7280', cancelled: '#ef4444', pending: 'var(--primary-light)' };
      return c[s] || '#94a3b8';
    });

    new Chart(document.getElementById('statusChart'), {
      type: 'doughnut',
      data: { labels: statusLabels, datasets: [{ data: statusValues, backgroundColor: statusColors, borderWidth: 0, hoverOffset: 8 }] },
      options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, pointStyle: 'circle', font: { size: 12 } } } }, cutout: '65%' }
    });

    // Priority Bar Chart
    var priorityData = <%= raw @priority_counts.to_json %>;
    var prioLabels = Object.keys(priorityData).map(function(s) { return s.replace(/_/g, ' ').replace(/\b\w/g, function(l) { return l.toUpperCase(); }); });
    var prioValues = Object.values(priorityData);
    var prioColors = Object.keys(priorityData).map(function(s) {
      var c = { critical: '#dc2626', high: '#f97316', medium: '#eab308', low: '#22c55e', none: '#94a3b8' };
      return c[s] || 'var(--primary)';
    });

    new Chart(document.getElementById('priorityChart'), {
      type: 'bar',
      data: { labels: prioLabels, datasets: [{ data: prioValues, backgroundColor: prioColors, borderRadius: 8, borderSkipped: false, barThickness: 40 }] },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 12 } }, grid: { color: '#f1f5f9' } }, x: { grid: { display: false }, ticks: { font: { size: 12 } } } } }
    });
  });
</script>

<%= render "shared/report_chart_styles" %>
