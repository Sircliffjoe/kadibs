<%= content_for :title, "Technician Productivity - Kadibs" %>

<!-- Breadcrumb -->
<div class="rpt-breadcrumb">
  <%= link_to "Reports", reports_dashboard_path, class: "rpt-breadcrumb-link" %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;color:#94a3b8;"><polyline points="9 18 15 12 9 6"/></svg>
  <span class="rpt-breadcrumb-current">Technician Productivity</span>
</div>

<!-- Header -->
<div class="rpt-hero">
  <div class="rpt-hero-bg"></div>
  <div class="rpt-hero-content">
    <div class="rpt-hero-left">
      <div class="rpt-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </div>
      <div>
        <h1 class="rpt-hero-title">Technician Productivity</h1>
        <p class="rpt-hero-sub"><%= @tech_stats.size %> technicians tracked</p>
      </div>
    </div>
  </div>
</div>

<!-- KPI Summary -->
<div class="rpt-kpi-grid">
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#eef2ff;color:var(--primary);">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value"><%= @tech_stats.size %></span>
      <span class="rpt-kpi-label">Technicians</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#dcfce7;color:#16a34a;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#16a34a;"><%= @tech_stats.sum { |s| s[:completed_wos] } %></span>
      <span class="rpt-kpi-label">Total Completed</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#dbeafe;color:#2563eb;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#2563eb;"><%= @tech_stats.sum { |s| s[:open_wos] } %></span>
      <span class="rpt-kpi-label">Open Orders</span>
    </div>
  </div>
</div>

<!-- Productivity Chart -->
<div class="rpt-card" style="margin-bottom:1.5rem;">
  <div class="rpt-card-header"><h3>Technician Workload Comparison</h3></div>
  <div class="rpt-card-body" style="padding:1.5rem;">
    <canvas id="techChart" style="max-height:340px;width:100%;"></canvas>
  </div>
</div>

<!-- Technicians Table -->
<div class="rpt-card">
  <div class="rpt-card-header">
    <h3>Technician Details</h3>
    <span class="rpt-badge"><%= @tech_stats.size %> people</span>
  </div>
  <div class="rpt-table-wrap">
    <table class="rpt-table">
      <thead>
        <tr>
          <th>Technician</th>
          <th>Completed</th>
          <th>Open</th>
          <th>Completion Rate</th>
          <th>Workload</th>
        </tr>
      </thead>
      <tbody>
        <% if @tech_stats.any? %>
          <% @tech_stats.sort_by { |s| -s[:completed_wos] }.each do |stat| %>
            <% total = stat[:completed_wos] + stat[:open_wos] %>
            <% rate = total > 0 ? (stat[:completed_wos].to_f / total * 100).round : 0 %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:0.75rem;">
                  <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-light));display:flex;align-items:center;justify-content:center;color:white;font-weight:600;font-size:0.75rem;flex-shrink:0;">
                    <%= stat[:user].first_name&.first %><%= stat[:user].last_name&.first %>
                  </div>
                  <div>
                    <div style="font-weight:600;color:#1e293b;font-size:0.85rem;"><%= stat[:user].full_name %></div>
                    <div style="font-size:0.72rem;color:#94a3b8;"><%= stat[:user].email %></div>
                  </div>
                </div>
              </td>
              <td><span style="font-weight:700;color:#16a34a;"><%= stat[:completed_wos] %></span></td>
              <td><span style="font-weight:600;color:#2563eb;"><%= stat[:open_wos] %></span></td>
              <td>
                <div style="display:flex;align-items:center;gap:0.5rem;">
                  <div style="flex:1;height:6px;background:#f1f5f9;border-radius:3px;overflow:hidden;max-width:80px;">
                    <div style="width:<%= rate %>%;height:100%;background:<%= rate >= 75 ? '#10b981' : (rate >= 50 ? '#f59e0b' : '#ef4444') %>;border-radius:3px;"></div>
                  </div>
                  <span style="font-size:0.8rem;font-weight:600;color:#334155;"><%= rate %>%</span>
                </div>
              </td>
              <td>
                <span class="rpt-pill" style="background:<%= total > 10 ? '#fee2e2' : (total > 5 ? '#fef3c7' : '#dcfce7') %>;color:<%= total > 10 ? '#b91c1c' : (total > 5 ? '#b45309' : '#166534') %>;"><%= total > 10 ? 'Heavy' : (total > 5 ? 'Medium' : 'Light') %></span>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="5" class="rpt-empty-cell">No technician data available</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var techNames = <%= raw @tech_stats.map { |s| s[:user].full_name }.to_json %>;
    var completed = <%= raw @tech_stats.map { |s| s[:completed_wos] }.to_json %>;
    var open = <%= raw @tech_stats.map { |s| s[:open_wos] }.to_json %>;

    new Chart(document.getElementById('techChart'), {
      type: 'bar',
      data: {
        labels: techNames,
        datasets: [
          { label: 'Completed', data: completed, backgroundColor: '#10b981', borderRadius: 6, borderSkipped: false },
          { label: 'Open', data: open, backgroundColor: '#3b82f6', borderRadius: 6, borderSkipped: false }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'top', labels: { padding: 16, usePointStyle: true, pointStyle: 'circle', font: { size: 12 } } } },
        scales: {
          y: { beginAtZero: true, stacked: false, grid: { color: '#f1f5f9' }, ticks: { stepSize: 1, font: { size: 12 } } },
          x: { grid: { display: false }, ticks: { font: { size: 12 } } }
        }
      }
    });
  });
</script>

<%= render "shared/report_chart_styles" %>
