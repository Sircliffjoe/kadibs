<%= content_for :title, "Cost Analysis - Kadibs" %>

<!-- Breadcrumb -->
<div class="rpt-breadcrumb">
  <%= link_to "Reports", reports_dashboard_path, class: "rpt-breadcrumb-link" %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;color:#94a3b8;"><polyline points="9 18 15 12 9 6"/></svg>
  <span class="rpt-breadcrumb-current">Cost Analysis</span>
</div>

<!-- Header -->
<div class="rpt-hero">
  <div class="rpt-hero-bg"></div>
  <div class="rpt-hero-content">
    <div class="rpt-hero-left">
      <div class="rpt-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="12" y1="1" x2="12" y2="23"/>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
      </div>
      <div>
        <h1 class="rpt-hero-title">Cost Analysis</h1>
        <p class="rpt-hero-sub">Last 12 months financial overview</p>
      </div>
    </div>
  </div>
</div>

<!-- KPI Cards -->
<div class="rpt-kpi-grid">
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#eef2ff;color:#6366f1;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value"><%= number_to_currency(@maintenance_costs, precision: 0) %></span>
      <span class="rpt-kpi-label">Maintenance Costs</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#dbeafe;color:#2563eb;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#2563eb;"><%= number_to_currency(@purchase_costs, precision: 0) %></span>
      <span class="rpt-kpi-label">Purchasing Costs</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#fef3c7;color:#d97706;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#d97706;"><%= number_to_currency((@maintenance_costs || 0) + (@purchase_costs || 0), precision: 0) %></span>
      <span class="rpt-kpi-label">Total Spend</span>
    </div>
  </div>
  <div class="rpt-kpi-card">
    <div class="rpt-kpi-icon" style="background:#dcfce7;color:#16a34a;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
    </div>
    <div class="rpt-kpi-info">
      <span class="rpt-kpi-value" style="color:#16a34a;"><%= @monthly_costs.any? ? number_to_currency(@monthly_costs.values.last || 0, precision: 0) : "$0" %></span>
      <span class="rpt-kpi-label">Latest Month</span>
    </div>
  </div>
</div>

<!-- Monthly Cost Trend Chart -->
<div class="rpt-card">
  <div class="rpt-card-header">
    <h3>Monthly Cost Trend</h3>
    <span class="rpt-badge">Last 12 months</span>
  </div>
  <div class="rpt-card-body" style="padding:1.5rem;">
    <canvas id="costTrendChart" style="max-height:320px;width:100%;"></canvas>
  </div>
</div>

<!-- Cost Breakdown by Type -->
<div class="rpt-charts-row" style="margin-top:1.5rem;">
  <div class="rpt-card">
    <div class="rpt-card-header"><h3>Cost Split</h3></div>
    <div class="rpt-card-body" style="display:flex;justify-content:center;padding:1.5rem;">
      <canvas id="costSplitChart" style="max-height:260px;"></canvas>
    </div>
  </div>
  <div class="rpt-card">
    <div class="rpt-card-header"><h3>Monthly Breakdown</h3></div>
    <div class="rpt-table-wrap">
      <table class="rpt-table">
        <thead>
          <tr>
            <th>Month</th>
            <th style="text-align:right;">Cost</th>
          </tr>
        </thead>
        <tbody>
          <% if @monthly_costs.any? %>
            <% @monthly_costs.sort.reverse.each do |month, cost| %>
              <tr>
                <td><%= month.strftime("%B %Y") %></td>
                <td style="text-align:right;font-weight:600;"><%= number_to_currency(cost) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="2" class="rpt-empty-cell">No cost data available</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var monthlyData = <%= raw @monthly_costs.sort.to_h.transform_keys { |k| k.strftime("%b %Y") }.to_json %>;
    var labels = Object.keys(monthlyData);
    var values = Object.values(monthlyData);

    // Area/Line Chart
    new Chart(document.getElementById('costTrendChart'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'Monthly Cost',
          data: values,
          borderColor: '#6366f1',
          backgroundColor: 'rgba(99,102,241,0.08)',
          borderWidth: 2.5,
          fill: true,
          tension: 0.4,
          pointBackgroundColor: '#6366f1',
          pointBorderColor: '#fff',
          pointBorderWidth: 2,
          pointRadius: 5,
          pointHoverRadius: 7
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 12 }, callback: function(v) { return '$' + v.toLocaleString(); } } },
          x: { grid: { display: false }, ticks: { font: { size: 11 } } }
        }
      }
    });

    // Cost Split Doughnut
    var maintenance = <%= @maintenance_costs || 0 %>;
    var purchasing = <%= @purchase_costs || 0 %>;
    
    new Chart(document.getElementById('costSplitChart'), {
      type: 'doughnut',
      data: {
        labels: ['Maintenance', 'Purchasing'],
        datasets: [{
          data: [maintenance, purchasing],
          backgroundColor: ['#6366f1', '#3b82f6'],
          borderWidth: 0,
          hoverOffset: 8
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, pointStyle: 'circle', font: { size: 12 } } } },
        cutout: '65%'
      }
    });
  });
</script>

<%= render "shared/report_chart_styles" %>
